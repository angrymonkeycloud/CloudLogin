<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Product>Cloud Login API</Product>
		<AssemblyName>AngryMonkey.CloudLogin.API</AssemblyName>
		<RootNamespace>AngryMonkey.CloudLogin.API</RootNamespace>
		<Version>2.2.0</Version>
		<Authors>Angry Monkey</Authors>
		<Company>Angry Monkey</Company>
		<AssemblyVersion>$(PackageVersion)</AssemblyVersion>
		<FileVersion>$(PackageVersion)</FileVersion>
		<PackageIcon>amc-logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>HTTP endpoints for CloudLogin: exposes CloudLogin.Server's authentication, account, and request services over the API surface CloudLogin.Client and other callers consume.</Description>
		<PackageTags>cloudlogin;authentication;aspnetcore;api;angrymonkey</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\CloudLogin.Server\CloudLogin.Server.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="artifacts\**" />
		<None Update="amc-logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md" Pack="True" PackagePath="\" Link="README.md" />
	</ItemGroup>

</Project>
