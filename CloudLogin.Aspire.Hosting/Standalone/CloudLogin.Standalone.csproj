<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <CloudLoginSourceRoot>__CLOUDLOGIN_SOURCE_ROOT__</CloudLoginSourceRoot>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(CloudLoginSourceRoot)/CloudLogin.Web/CloudLogin.Web.csproj')">
    <ProjectReference Include="$(CloudLoginSourceRoot)/CloudLogin.Web/CloudLogin.Web.csproj" />
    <ProjectReference Include="$(CloudLoginSourceRoot)/CloudLogin.Aspire/CloudLogin.Aspire.csproj" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(CloudLoginSourceRoot)/CloudLogin.Web/CloudLogin.Web.csproj')">
    <PackageReference Include="AngryMonkey.CloudLogin.Web" Version="1.6.4" />
    <PackageReference Include="AngryMonkey.CloudLogin.Aspire" Version="1.0.0" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" />
  </ItemGroup>
</Project>
