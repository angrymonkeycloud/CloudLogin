<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>AngryMonkey.CloudLogin.Cli</AssemblyName>
		<RootNamespace>AngryMonkey.CloudLogin.Cli</RootNamespace>
		<Product>Cloud Login CLI</Product>
		<Authors>Angry Monkey</Authors>
		<Company>Angry Monkey</Company>
		<Version>2.3.0</Version>
		<AssemblyVersion>$(PackageVersion)</AssemblyVersion>
		<FileVersion>$(PackageVersion)</FileVersion>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>cloudlogin</ToolCommandName>
		<PackageIcon>amc-logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Description>Signs in to a CloudLogin application from the command line exactly as its native app does, and checks every step of sign-in, session renewal and logout against a running deployment.</Description>
		<PackageTags>cloudlogin;authentication;cli;testing;angrymonkey</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\CloudLogin.Contracts\amc-logo.png" Pack="True" PackagePath="\" Link="amc-logo.png" />
		<None Include="README.md" Pack="True" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CloudLogin.Cli.Core\CloudLogin.Cli.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CloudLogin.Tests" />
	</ItemGroup>

</Project>
