<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>true</IsPackable>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<AssemblyName>AngryMonkey.CloudLogin.Components</AssemblyName>
		<RootNamespace>AngryMonkey.CloudLogin</RootNamespace>
		<AssemblyVersion>$(PackageVersion)</AssemblyVersion>
		<FileVersion>$(PackageVersion)</FileVersion>
		<Version>1.6.4</Version>
		<Authors>Angry Monkey</Authors>
		<Company>Angry Monkey</Company>
		<PackageIcon>amc-logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Product>Cloud Login Components</Product>
		<Configurations>Debug;Release</Configurations>
		<Description />
		<PackageOutputPath>../../../../../NugetPackages</PackageOutputPath>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="artifacts\**" />
		<Content Remove="mateconfig.json" />
	</ItemGroup>

	<ItemGroup>
		<SupportedPlatform Include="browser" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
		<PackageReference Include="QRCoder" Version="1.8.0" />
		<PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\CloudComponents\CloudComponents.DataGrid\CloudComponents.DataGrid.csproj" />
		<ProjectReference Include="..\..\CloudComponents\CloudComponents.Icons\CloudComponents.Icons.csproj" />
		<ProjectReference Include="..\..\CloudComponents\CloudComponents\CloudComponents.csproj" />
		<ProjectReference Include="..\CloudLogin.Client\CloudLogin.Client.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Components\ForgetPassword\" />
		<Folder Include="Services\" />
	</ItemGroup>

	<ItemGroup>
		<None Update="amc-logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md" Pack="True" PackagePath="\" Link="README.md" />
		<None Include="compilerconfig.json" />
		<None Include="Components\Account\AccountComponent-Emails.razor.min.css" />
		<None Include="Components\Account\AccountComponent-PaymentMethods.razor.min.css" />
		<None Include="mateconfig.json" />
	</ItemGroup>

</Project>
