@namespace AngryMonkey.CloudLogin
@using AngryMonkey.CloudLogin.Interfaces
@using AngryMonkey.CloudLogin.Models
@inject ICloudLogin cloudLogin

<div class="card contacts-card">
    <div class="card-header">
        <h4>Email addresses</h4>
        @if (!_verification.IsAwaitingCode && !_isAdding)
        {
            <button class="link-action" @onclick="StartAdd" disabled="@_isProcessing">Add email</button>
        }
    </div>

    @if (_isAdding || _verification.IsAwaitingCode)
    {
        <div class="add-panel">
            @if (!_verification.IsAwaitingCode)
            {
                <label class="add-label" for="new-email">New email address</label>
                <div class="add-row">
                    <input type="email"
                           id="new-email"
                           class="form-input"
                           @bind="NewEmail"
                           @bind:event="oninput"
                           placeholder="you@example.com"
                           disabled="@_isProcessing" />
                    <button class="btn btn-primary"
                            @onclick="SendCode"
                            disabled="@(_isProcessing || !IsValidEmail(NewEmail))">
                        @if (_isProcessing)
                        {
                            <span class="loading-spinner"></span>
                            <span>Checking…</span>
                        }
                        else
                        {
                            <span>Send code</span>
                        }
                    </button>
                    <button class="btn btn-outline" @onclick="CancelAdd" disabled="@_isProcessing">Cancel</button>
                </div>
                <p class="add-hint">We'll email a 6-digit code to confirm you own this address before adding it.</p>
            }
            else
            {
                <label class="add-label" for="email-code">Enter the code sent to <strong>@_verification.PendingInput</strong></label>
                <div class="add-row">
                    <input type="text"
                           id="email-code"
                           class="form-input code-input"
                           inputmode="numeric"
                           maxlength="6"
                           autocomplete="one-time-code"
                           @bind="_verification.EnteredCode"
                           @bind:event="oninput"
                           placeholder="000000"
                           disabled="@_isProcessing" />
                    <button class="btn btn-primary"
                            @onclick="ConfirmCode"
                            disabled="@(_isProcessing || string.IsNullOrWhiteSpace(_verification.EnteredCode))">
                        @if (_isProcessing)
                        {
                            <span class="loading-spinner"></span>
                            <span>Verifying…</span>
                        }
                        else
                        {
                            <span>Verify &amp; add</span>
                        }
                    </button>
                    <button class="btn btn-outline" @onclick="CancelAdd" disabled="@_isProcessing">Cancel</button>
                </div>
                <p class="add-hint">
                    Didn't get it?
                    <button class="link-action" @onclick="ResendCode" disabled="@_isProcessing">Resend code</button>
                </p>
            }
        </div>
    }

    @if (CurrentUser.EmailAddresses.Any())
    {
        <div class="contact-list">
            @foreach (CloudLoginInputModel email in CurrentUser.EmailAddresses.OrderByDescending(e => e.IsPrimary))
            {
                <div class="contact-row">
                    <div class="contact-main">
                        <span class="contact-icon" aria-hidden="true"><PersonIcon /></span>
                        <span class="contact-text">@email.Input</span>
                        @if (email.IsPrimary)
                        {
                            <span class="badge badge-primary">Primary</span>
                        }
                    </div>
                    <div class="contact-actions">
                        @if (!email.IsPrimary)
                        {
                            <button class="btn btn-outline btn-sm"
                                    @onclick="() => SetPrimary(email.Input)"
                                    disabled="@_isProcessing">
                                Make primary
                            </button>
                        }
                        @if (CurrentUser.EmailAddresses.Count > 1)
                        {
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => RemoveEmail(email.Input)"
                                    disabled="@_isProcessing">
                                Remove
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No email addresses configured.</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="@(_operationSuccess ? "alert-success" : "alert-error")">
            @_statusMessage
        </div>
    }
</div>

@code {
    [Parameter] public required CloudUserModel CurrentUser { get; set; }

    [CascadingParameter] private AccountErrorCenter? ErrorCenter { get; set; }

    private string NewEmail { get; set; } = string.Empty;
    private bool _isProcessing = false;
    private bool _isAdding = false;
    private string _statusMessage = string.Empty;
    private bool _operationSuccess = false;

    private readonly AccountContactVerification _verification = new();

    private void StartAdd()
    {
        _isAdding = true;
        NewEmail = string.Empty;
        _statusMessage = string.Empty;
    }

    private void CancelAdd()
    {
        _isAdding = false;
        NewEmail = string.Empty;
        _verification.Reset();
        _statusMessage = string.Empty;
    }

    /// <summary>
    /// Confirms the address isn't already taken, then sends a verification code to it.
    /// The input is not attached to the account until that code comes back.
    /// </summary>
    private async Task SendCode()
    {
        if (_isProcessing || !IsValidEmail(NewEmail))
            return;

        string normalized = NewEmail.Trim().ToLowerInvariant();

        try
        {
            _isProcessing = true;
            _statusMessage = string.Empty;
            StateHasChanged();

            if (CurrentUser.EmailAddresses.Any(e => e.Input.Equals(normalized, StringComparison.OrdinalIgnoreCase)))
            {
                SetStatus("This email address is already on your account.", false);
                return;
            }

            CloudUser? existingUser = await cloudLogin.GetUserByEmailAddress(normalized);
            if (existingUser != null && existingUser.Id != CurrentUser.Id)
            {
                SetStatus("This email address is already in use by another account.", false);
                return;
            }

            string code = _verification.Start(normalized);
            await cloudLogin.SendEmailCode(normalized, code);

            SetStatus($"We sent a code to {normalized}.", true);
        }
        catch (Exception ex)
        {
            _verification.Reset();
            SetStatus($"Failed to send verification code: {ex.Message}", false);
            ErrorCenter?.Report("Profile — Email addresses", _statusMessage, ex);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ResendCode()
    {
        if (_isProcessing || !_verification.IsAwaitingCode)
            return;

        try
        {
            _isProcessing = true;
            StateHasChanged();

            string code = _verification.Reissue();
            await cloudLogin.SendEmailCode(_verification.PendingInput, code);

            SetStatus($"We sent a new code to {_verification.PendingInput}.", true);
        }
        catch (Exception ex)
        {
            SetStatus($"Failed to resend code: {ex.Message}", false);
            ErrorCenter?.Report("Profile — Email addresses", _statusMessage, ex);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    /// <summary>Validates the entered code and, only on success, persists the new address.</summary>
    private async Task ConfirmCode()
    {
        if (_isProcessing || !_verification.IsAwaitingCode)
            return;

        switch (_verification.Check())
        {
            case VerificationCodeResult.NotValid:
                SetStatus("That code isn't correct. Please check and try again.", false);
                return;

            case VerificationCodeResult.Expired:
                SetStatus("That code has expired. Request a new one.", false);
                return;
        }

        try
        {
            _isProcessing = true;
            StateHasChanged();

            string verifiedInput = _verification.PendingInput;

            CloudLoginInputModel newEmailInput = new()
            {
                Input = verifiedInput,
                Format = CloudLoginInputFormat.EmailAddress,
                IsPrimary = !CurrentUser.EmailAddresses.Any(),
                Providers = []
            };

            CurrentUser.Inputs.Add(newEmailInput);
            await cloudLogin.UpdateUser(CurrentUser.ToContract());

            _verification.Reset();
            _isAdding = false;
            NewEmail = string.Empty;

            SetStatus("Email address verified and added.", true);
        }
        catch (Exception ex)
        {
            SetStatus($"Failed to add email address: {ex.Message}", false);
            ErrorCenter?.Report("Profile — Email addresses", _statusMessage, ex);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
            await ClearStatusMessageAfterDelay();
        }
    }

    /// <summary>
    /// Removes an email address from the user's account
    /// </summary>
    private async Task RemoveEmail(string email)
    {
        if (_isProcessing || CurrentUser.EmailAddresses.Count <= 1)
            return;

        try
        {
            _isProcessing = true;
            _statusMessage = string.Empty;
            StateHasChanged();

            var emailToRemove = CurrentUser.Inputs.FirstOrDefault(e =>
                e.Format == CloudLoginInputFormat.EmailAddress &&
                e.Input.Equals(email, StringComparison.OrdinalIgnoreCase));

            if (emailToRemove == null)
            {
                SetStatus("Email address not found.", false);
                return;
            }

            // If removing primary email, set another as primary
            if (emailToRemove.IsPrimary)
            {
                var nextPrimary = CurrentUser.EmailAddresses.FirstOrDefault(e => e != emailToRemove);
                if (nextPrimary != null)
                    nextPrimary.IsPrimary = true;
            }

            CurrentUser.Inputs.Remove(emailToRemove);
            await cloudLogin.UpdateUser(CurrentUser.ToContract());

            SetStatus("Email address removed successfully.", true);
        }
        catch (Exception ex)
        {
            SetStatus($"Failed to remove email address: {ex.Message}", false);
            ErrorCenter?.Report("Profile — Email addresses", _statusMessage, ex);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
            await ClearStatusMessageAfterDelay();
        }
    }

    /// <summary>
    /// Sets an email address as the primary email
    /// </summary>
    private async Task SetPrimary(string email)
    {
        if (_isProcessing)
            return;

        try
        {
            _isProcessing = true;
            _statusMessage = string.Empty;
            StateHasChanged();

            // Update primary status
            foreach (var e in CurrentUser.EmailAddresses)
                e.IsPrimary = e.Input.Equals(email, StringComparison.OrdinalIgnoreCase);

            await cloudLogin.UpdateUser(CurrentUser.ToContract());

            SetStatus("Primary email address updated successfully.", true);
        }
        catch (Exception ex)
        {
            SetStatus($"Failed to update primary email: {ex.Message}", false);
            ErrorCenter?.Report("Profile — Email addresses", _statusMessage, ex);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
            await ClearStatusMessageAfterDelay();
        }
    }

    private void SetStatus(string message, bool success)
    {
        _statusMessage = message;
        _operationSuccess = success;
    }

    /// <summary>
    /// Validates email address format
    /// </summary>
    private static bool IsValidEmail(string email)
    {
        if (string.IsNullOrWhiteSpace(email))
            return false;

        return System.Text.RegularExpressions.Regex.IsMatch(email.Trim(),
            @"^[a-zA-Z0-9]([a-zA-Z0-9._-]*[a-zA-Z0-9])?@[a-zA-Z0-9]([a-zA-Z0-9.-]*[a-zA-Z0-9])?\.[a-zA-Z]{2,}$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);
    }

    /// <summary>
    /// Clears status message after a delay
    /// </summary>
    private async Task ClearStatusMessageAfterDelay()
    {
        if (_operationSuccess)
        {
            await Task.Delay(3000);
            _statusMessage = string.Empty;
            StateHasChanged();
        }
    }
}
