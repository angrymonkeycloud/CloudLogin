@namespace AngryMonkey.CloudLogin
@using AngryMonkey.CloudLogin.Interfaces
@using AngryMonkey.CloudLogin.Models
@inject ICloudLogin cloudLogin

<div class="card contacts-card">
    <div class="card-header">
        <h4>Phone numbers</h4>
        @if (!_verification.IsAwaitingCode && !_isAdding)
        {
            <button class="link-action" @onclick="StartAdd" disabled="@_isProcessing">Add phone</button>
        }
    </div>

    @if (_isAdding || _verification.IsAwaitingCode)
    {
        <div class="add-panel">
            @if (!_verification.IsAwaitingCode)
            {
                <label class="add-label" for="new-phone">New phone number</label>
                <div class="add-row">
                    <input type="tel"
                           id="new-phone"
                           class="form-input"
                           @bind="NewPhoneNumber"
                           @bind:event="oninput"
                           placeholder="+1 555-123-4567"
                           disabled="@_isProcessing" />
                    <button class="btn btn-primary"
                            @onclick="SendCode"
                            disabled="@(_isProcessing || !IsValidPhoneNumber(NewPhoneNumber))">
                        @if (_isProcessing)
                        {
                            <span class="loading-spinner"></span>
                            <span>Checking…</span>
                        }
                        else
                        {
                            <span>Send code</span>
                        }
                    </button>
                    <button class="btn btn-outline" @onclick="CancelAdd" disabled="@_isProcessing">Cancel</button>
                </div>
                <p class="add-hint">Include the country code (e.g. +1 for US). We'll send a 6-digit code over WhatsApp to confirm the number is yours.</p>
            }
            else
            {
                <label class="add-label" for="phone-code">Enter the code sent to <strong>@FormatPhoneNumber(_verification.PendingInput)</strong></label>
                <div class="add-row">
                    <input type="text"
                           id="phone-code"
                           class="form-input code-input"
                           inputmode="numeric"
                           maxlength="6"
                           autocomplete="one-time-code"
                           @bind="_verification.EnteredCode"
                           @bind:event="oninput"
                           placeholder="000000"
                           disabled="@_isProcessing" />
                    <button class="btn btn-primary"
                            @onclick="ConfirmCode"
                            disabled="@(_isProcessing || string.IsNullOrWhiteSpace(_verification.EnteredCode))">
                        @if (_isProcessing)
                        {
                            <span class="loading-spinner"></span>
                            <span>Verifying…</span>
                        }
                        else
                        {
                            <span>Verify &amp; add</span>
                        }
                    </button>
                    <button class="btn btn-outline" @onclick="CancelAdd" disabled="@_isProcessing">Cancel</button>
                </div>
                <p class="add-hint">
                    Didn't get it?
                    <button class="link-action" @onclick="ResendCode" disabled="@_isProcessing">Resend code</button>
                </p>
            }
        </div>
    }

    @if (CurrentUser.PhoneNumbers.Any())
    {
        <div class="contact-list">
            @foreach (CloudLoginInputModel phone in CurrentUser.PhoneNumbers.OrderByDescending(p => p.IsPrimary))
            {
                <div class="contact-row">
                    <div class="contact-main">
                        <span class="contact-icon" aria-hidden="true"><PersonIcon /></span>
                        <span class="contact-text">@FormatPhoneNumber(phone.Input)</span>
                        @if (phone.IsPrimary)
                        {
                            <span class="badge badge-primary">Primary</span>
                        }
                        @if (!string.IsNullOrEmpty(phone.PhoneNumberCountryCode))
                        {
                            <span class="badge badge-info">@phone.PhoneNumberCountryCode</span>
                        }
                    </div>
                    <div class="contact-actions">
                        @if (!phone.IsPrimary)
                        {
                            <button class="btn btn-outline btn-sm"
                                    @onclick="() => SetPrimary(phone.Input)"
                                    disabled="@_isProcessing">
                                Make primary
                            </button>
                        }
                        @if (CurrentUser.PhoneNumbers.Count > 1 || CurrentUser.EmailAddresses.Any())
                        {
                            <button class="btn btn-danger btn-sm"
                                    @onclick="() => RemovePhoneNumber(phone.Input)"
                                    disabled="@_isProcessing">
                                Remove
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <p>No phone numbers configured.</p>
        </div>
    }

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="@(_operationSuccess ? "alert-success" : "alert-error")">
            @_statusMessage
        </div>
    }
</div>

@code {
    [Parameter] public required CloudUserModel CurrentUser { get; set; }

    [CascadingParameter] private AccountErrorCenter? ErrorCenter { get; set; }

    private string NewPhoneNumber { get; set; } = string.Empty;
    private bool _isProcessing = false;
    private bool _isAdding = false;
    private string _statusMessage = string.Empty;
    private bool _operationSuccess = false;

    private readonly AccountContactVerification _verification = new();

    private void StartAdd()
    {
        _isAdding = true;
        NewPhoneNumber = string.Empty;
        _statusMessage = string.Empty;
    }

    private void CancelAdd()
    {
        _isAdding = false;
        NewPhoneNumber = string.Empty;
        _verification.Reset();
        _statusMessage = string.Empty;
    }

    /// <summary>
    /// Confirms the number isn't already taken, then sends a verification code to it.
    /// The input is not attached to the account until that code comes back.
    /// </summary>
    private async Task SendCode()
    {
        if (_isProcessing || !IsValidPhoneNumber(NewPhoneNumber))
            return;

        string normalized = NormalizePhoneNumber(NewPhoneNumber);

        try
        {
            _isProcessing = true;
            _statusMessage = string.Empty;
            StateHasChanged();

            if (CurrentUser.PhoneNumbers.Any(p => p.Input.Equals(normalized, StringComparison.OrdinalIgnoreCase)))
            {
                SetStatus("This phone number is already on your account.", false);
                return;
            }

            CloudUser? existingUser = await cloudLogin.GetUserByPhoneNumber(normalized);
            if (existingUser != null && existingUser.ID != CurrentUser.ID)
            {
                SetStatus("This phone number is already in use by another account.", false);
                return;
            }

            string code = _verification.Start(normalized);
            await cloudLogin.SendWhatsAppCode(normalized, code);

            SetStatus($"We sent a code to {FormatPhoneNumber(normalized)}.", true);
        }
        catch (Exception ex)
        {
            _verification.Reset();
            SetStatus($"Failed to send verification code: {ex.Message}", false);
            ErrorCenter?.Report("Profile — Phone numbers", _statusMessage, ex);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ResendCode()
    {
        if (_isProcessing || !_verification.IsAwaitingCode)
            return;

        try
        {
            _isProcessing = true;
            StateHasChanged();

            string code = _verification.Reissue();
            await cloudLogin.SendWhatsAppCode(_verification.PendingInput, code);

            SetStatus($"We sent a new code to {FormatPhoneNumber(_verification.PendingInput)}.", true);
        }
        catch (Exception ex)
        {
            SetStatus($"Failed to resend code: {ex.Message}", false);
            ErrorCenter?.Report("Profile — Phone numbers", _statusMessage, ex);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    /// <summary>Validates the entered code and, only on success, persists the new number.</summary>
    private async Task ConfirmCode()
    {
        if (_isProcessing || !_verification.IsAwaitingCode)
            return;

        switch (_verification.Check())
        {
            case VerificationCodeResult.NotValid:
                SetStatus("That code isn't correct. Please check and try again.", false);
                return;

            case VerificationCodeResult.Expired:
                SetStatus("That code has expired. Request a new one.", false);
                return;
        }

        try
        {
            _isProcessing = true;
            StateHasChanged();

            string verifiedInput = _verification.PendingInput;

            CloudLoginInputModel newPhoneInput = new()
            {
                Input = verifiedInput,
                Format = CloudLoginInputFormat.PhoneNumber,
                // First contact of any kind becomes primary.
                IsPrimary = !CurrentUser.PhoneNumbers.Any() && !CurrentUser.EmailAddresses.Any(),
                Providers = []
            };

            CurrentUser.Inputs.Add(newPhoneInput);
            await cloudLogin.UpdateUser(CurrentUser.ToContract());

            _verification.Reset();
            _isAdding = false;
            NewPhoneNumber = string.Empty;

            SetStatus("Phone number verified and added.", true);
        }
        catch (Exception ex)
        {
            SetStatus($"Failed to add phone number: {ex.Message}", false);
            ErrorCenter?.Report("Profile — Phone numbers", _statusMessage, ex);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
            await ClearStatusMessageAfterDelay();
        }
    }

    /// <summary>
    /// Removes a phone number from the user's account
    /// </summary>
    private async Task RemovePhoneNumber(string phoneNumber)
    {
        if (_isProcessing)
            return;

        // Ensure user has at least one contact method
        if (CurrentUser.PhoneNumbers.Count <= 1 && !CurrentUser.EmailAddresses.Any())
        {
            SetStatus("You must have at least one contact method (email or phone).", false);
            await ClearStatusMessageAfterDelay();
            return;
        }

        try
        {
            _isProcessing = true;
            _statusMessage = string.Empty;
            StateHasChanged();

            var phoneToRemove = CurrentUser.Inputs.FirstOrDefault(p =>
                p.Format == CloudLoginInputFormat.PhoneNumber &&
                p.Input.Equals(phoneNumber, StringComparison.OrdinalIgnoreCase));

            if (phoneToRemove == null)
            {
                SetStatus("Phone number not found.", false);
                return;
            }

            // If removing primary phone, set another as primary
            if (phoneToRemove.IsPrimary)
            {
                var nextPrimary = CurrentUser.PhoneNumbers.FirstOrDefault(p => p != phoneToRemove) ??
                                 CurrentUser.EmailAddresses.FirstOrDefault();
                if (nextPrimary != null)
                    nextPrimary.IsPrimary = true;
            }

            CurrentUser.Inputs.Remove(phoneToRemove);
            await cloudLogin.UpdateUser(CurrentUser.ToContract());

            SetStatus("Phone number removed successfully.", true);
        }
        catch (Exception ex)
        {
            SetStatus($"Failed to remove phone number: {ex.Message}", false);
            ErrorCenter?.Report("Profile — Phone numbers", _statusMessage, ex);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
            await ClearStatusMessageAfterDelay();
        }
    }

    /// <summary>
    /// Sets a phone number as the primary contact
    /// </summary>
    private async Task SetPrimary(string phoneNumber)
    {
        if (_isProcessing)
            return;

        try
        {
            _isProcessing = true;
            _statusMessage = string.Empty;
            StateHasChanged();

            // Update primary status for all inputs
            foreach (var input in CurrentUser.Inputs)
                input.IsPrimary = input.Format == CloudLoginInputFormat.PhoneNumber &&
                                 input.Input.Equals(phoneNumber, StringComparison.OrdinalIgnoreCase);

            await cloudLogin.UpdateUser(CurrentUser.ToContract());

            SetStatus("Primary phone number updated successfully.", true);
        }
        catch (Exception ex)
        {
            SetStatus($"Failed to update primary phone number: {ex.Message}", false);
            ErrorCenter?.Report("Profile — Phone numbers", _statusMessage, ex);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
            await ClearStatusMessageAfterDelay();
        }
    }

    private void SetStatus(string message, bool success)
    {
        _statusMessage = message;
        _operationSuccess = success;
    }

    /// <summary>
    /// Validates phone number format
    /// </summary>
    private static bool IsValidPhoneNumber(string phoneNumber)
    {
        if (string.IsNullOrWhiteSpace(phoneNumber))
            return false;

        // Basic phone number validation - should start with + and contain only digits, spaces, hyphens, parentheses
        string cleaned = phoneNumber.Replace(" ", "").Replace("-", "").Replace("(", "").Replace(")", "").Replace(".", "");
        return System.Text.RegularExpressions.Regex.IsMatch(cleaned, @"^\+[1-9]\d{7,14}$");
    }

    /// <summary>
    /// Normalizes phone number format
    /// </summary>
    private static string NormalizePhoneNumber(string phoneNumber)
    {
        if (string.IsNullOrWhiteSpace(phoneNumber))
            return string.Empty;

        // Remove all non-digit characters except +
        string cleaned = System.Text.RegularExpressions.Regex.Replace(phoneNumber.Trim(), @"[^\d+]", "");

        // Ensure it starts with +
        if (!cleaned.StartsWith('+'))
            cleaned = "+" + cleaned;

        return cleaned;
    }

    /// <summary>
    /// Formats phone number for display
    /// </summary>
    private static string FormatPhoneNumber(string phoneNumber)
    {
        if (string.IsNullOrEmpty(phoneNumber))
            return phoneNumber;

        // Basic formatting for common country codes
        if (phoneNumber.StartsWith("+1") && phoneNumber.Length == 12)
        {
            // US/Canada format: +1 (555) 123-4567
            return $"{phoneNumber[..2]} ({phoneNumber[2..5]}) {phoneNumber[5..8]}-{phoneNumber[8..]}";
        }

        // For other formats, just return as-is
        return phoneNumber;
    }

    /// <summary>
    /// Clears status message after a delay
    /// </summary>
    private async Task ClearStatusMessageAfterDelay()
    {
        if (_operationSuccess)
        {
            await Task.Delay(3000);
            _statusMessage = string.Empty;
            StateHasChanged();
        }
    }
}
