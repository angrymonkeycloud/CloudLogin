@using AngryMonkey.CloudLogin.Interfaces
@inject ICloudLogin cloudLogin

@namespace AngryMonkey.CloudLogin

<div class="account-section">
    <div class="section-header">
        <h3>Organizations</h3>
        <p class="section-description">Organizations you belong to</p>
    </div>

    @if (_loading)
    {
        <div class="loading-spinner"></div>
    }
    else
    {
        <div class="card entity-card">
            <div class="card-header">
                <h4>Create organization</h4>
            </div>
            <div class="form-group">
                <input class="form-input" placeholder="Organization name" @bind="_newOrganizationName" disabled="@_creating" />
            </div>
            <div class="form-actions">
                <button class="btn btn-primary btn-sm" @onclick="CreateOrganizationAsync" disabled="@(_creating || string.IsNullOrWhiteSpace(_newOrganizationName))">
                    @(_creating ? "Creating..." : "Create")
                </button>
            </div>
            @if (!string.IsNullOrEmpty(_createMessage))
            {
                <div class="@(_createSuccess ? "alert-success" : "alert-error")">@_createMessage</div>
            }
        </div>

        if (_organizations.Count == 0)
        {
            <div class="empty-state">You're not a member of any organization yet.</div>
        }
        else
        {
            <div class="entity-list">
                @foreach (var organization in _organizations)
                {
                    bool isOwner = organization.OwnerUserId == CurrentUserId;
                    bool editing = _editingOrgId == organization.Id;
                    bool inviting = _invitingOrgId == organization.Id;

                    <div id="cloudlogin-organization-@organization.Id" class="card entity-card @(TargetOrganizationId == organization.Id ? "deep-link-target" : null)">
                        <div class="card-header">
                            <h4>@organization.Name</h4>
                            @if (isOwner)
                            {
                                <span class="badge badge-primary">Owner</span>
                            }
                        </div>
                        <div class="kv-list">
                            <div class="kv-row meta">
                                <div class="kv-key">Created</div>
                                <div class="kv-value">@organization.CreatedOn.ToString("MMMM dd, yyyy")</div>
                            </div>
                            <div class="kv-row">
                                <div class="kv-key">Billing email</div>
                                <div class="kv-value">
                                    @if (editing)
                                    {
                                        <input class="form-input" @bind="_editBillingEmail" placeholder="billing@company.com" />
                                    }
                                    else
                                    {
                                        @(string.IsNullOrWhiteSpace(organization.BillingEmail) ? "Not specified" : organization.BillingEmail)
                                    }
                                </div>
                            </div>
                            <div class="kv-row">
                                <div class="kv-key">Billing contact name</div>
                                <div class="kv-value">
                                    @if (editing)
                                    {
                                        <input class="form-input" @bind="_editBillingContactName" placeholder="Contact name" />
                                    }
                                    else
                                    {
                                        @(string.IsNullOrWhiteSpace(organization.BillingContactName) ? "Not specified" : organization.BillingContactName)
                                    }
                                </div>
                            </div>
                        </div>

                        @if (isOwner)
                        {
                            <div class="form-actions">
                                @if (editing)
                                {
                                    <button class="btn btn-primary btn-sm" @onclick="() => SaveOrganizationAsync(organization)" disabled="@_saving">Save</button>
                                    <button class="btn btn-outline btn-sm" @onclick="() => _editingOrgId = null">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-outline btn-sm" @onclick="() => StartEditOrganization(organization)">Edit billing info</button>
                                }
                            </div>
                        }

                        <div class="form-actions">
                            @if (inviting)
                            {
                                <input class="form-input" placeholder="Email or phone to invite" @bind="_inviteRecipient" disabled="@_saving" />
                                <button class="btn btn-primary btn-sm" @onclick="() => InviteAsync(organization.Id)" disabled="@(_saving || string.IsNullOrWhiteSpace(_inviteRecipient))">Send invite</button>
                                <button class="btn btn-outline btn-sm" @onclick="() => _invitingOrgId = null">Cancel</button>
                            }
                            else
                            {
                                <button class="btn btn-outline btn-sm" @onclick="() => StartInvite(organization.Id)">Invite</button>
                            }
                        </div>

                        @if (_messageOrgId == organization.Id && !string.IsNullOrEmpty(_actionMessage))
                        {
                            <div class="@(_actionSuccess ? "alert-success" : "alert-error")">@_actionMessage</div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    private List<CloudLoginOrganization> _organizations = [];
    [Parameter] public Guid? TargetOrganizationId { get; set; }

    private Guid? CurrentUserId;
    private bool _loading = true;

    private string _newOrganizationName = string.Empty;
    private bool _creating;
    private string _createMessage = string.Empty;
    private bool _createSuccess;

    private Guid? _editingOrgId;
    private string _editBillingEmail = string.Empty;
    private string _editBillingContactName = string.Empty;

    private Guid? _invitingOrgId;
    private string _inviteRecipient = string.Empty;

    private bool _saving;
    private Guid? _messageOrgId;
    private string _actionMessage = string.Empty;
    private bool _actionSuccess;

    protected override async Task OnInitializedAsync()
    {
        UserModel? user = await cloudLogin.CurrentUser();
        CurrentUserId = user?.ID;
        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync() => _organizations = await cloudLogin.GetMyOrganizations();

    private async Task CreateOrganizationAsync()
    {
        if (_creating || string.IsNullOrWhiteSpace(_newOrganizationName))
            return;

        try
        {
            _creating = true;
            _createMessage = string.Empty;
            StateHasChanged();

            await cloudLogin.CreateOrganization(_newOrganizationName.Trim());
            _newOrganizationName = string.Empty;
            await ReloadAsync();

            _createMessage = "Organization created.";
            _createSuccess = true;
        }
        catch (Exception ex)
        {
            _createMessage = $"Failed to create organization: {ex.Message}";
            _createSuccess = false;
        }
        finally
        {
            _creating = false;
            StateHasChanged();
        }
    }

    private void StartEditOrganization(CloudLoginOrganization organization)
    {
        _editingOrgId = organization.Id;
        _editBillingEmail = organization.BillingEmail ?? string.Empty;
        _editBillingContactName = organization.BillingContactName ?? string.Empty;
    }

    private async Task SaveOrganizationAsync(CloudLoginOrganization organization)
    {
        if (_saving)
            return;

        try
        {
            _saving = true;
            StateHasChanged();

            organization.BillingEmail = string.IsNullOrWhiteSpace(_editBillingEmail) ? null : _editBillingEmail.Trim();
            organization.BillingContactName = string.IsNullOrWhiteSpace(_editBillingContactName) ? null : _editBillingContactName.Trim();

            await cloudLogin.UpdateOrganization(organization);
            _editingOrgId = null;
            await ReloadAsync();

            _messageOrgId = organization.Id;
            _actionMessage = "Billing info updated.";
            _actionSuccess = true;
        }
        catch (Exception ex)
        {
            _messageOrgId = organization.Id;
            _actionMessage = $"Failed to update: {ex.Message}";
            _actionSuccess = false;
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private void StartInvite(Guid organizationId)
    {
        _invitingOrgId = organizationId;
        _inviteRecipient = string.Empty;
    }

    private async Task InviteAsync(Guid organizationId)
    {
        if (_saving || string.IsNullOrWhiteSpace(_inviteRecipient))
            return;

        try
        {
            _saving = true;
            StateHasChanged();

            await cloudLogin.InviteToOrganization(organizationId, _inviteRecipient.Trim());
            _invitingOrgId = null;

            _messageOrgId = organizationId;
            _actionMessage = $"Invitation sent to {_inviteRecipient.Trim()}.";
            _actionSuccess = true;
        }
        catch (Exception ex)
        {
            _messageOrgId = organizationId;
            _actionMessage = $"Failed to invite: {ex.Message}";
            _actionSuccess = false;
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }
}
