@using AngryMonkey.CloudLogin.Interfaces
@using AngryMonkey.CloudLogin.Models
@using System.Globalization
@inject ICloudLogin cloudLogin

@namespace AngryMonkey.CloudLogin

<div class="account-section overview-page">
    <div class="section-header">
        <h3>Account overview</h3>
        <p class="section-description">A quick look at your account and the areas you can manage.</p>
    </div>

    <div class="card hero-card">
        <div class="hero-identity">
            @if (!string.IsNullOrWhiteSpace(CurrentUser.ProfilePicture))
            {
                <img class="hero-avatar" src="@CurrentUser.ProfilePicture" alt="Profile picture" />
            }
            else
            {
                <div class="hero-avatar initials" aria-hidden="true">@GetInitials()</div>
            }
            <div class="hero-identity-copy">
                <div class="hero-name">@GetDisplayName()</div>
                <div class="hero-email">@GetPrimaryEmail()</div>
                @if (CurrentUser.IsLocked)
                {
                    <span class="chip chip--locked">Locked</span>
                }
                else
                {
                    <span class="chip chip--active">Active</span>
                }
            </div>
        </div>

        <div class="hero-meta">
            <div class="meta-item">
                <span class="meta-icon" aria-hidden="true"><CalendarIcon /></span>
                <div class="meta-copy">
                    <div class="meta-label">Member since</div>
                    <div class="meta-value">@FormatAbsolute(CurrentUser.CreatedOn, includeTime: false)</div>
                    <div class="meta-relative">@FormatRelative(CurrentUser.CreatedOn)</div>
                </div>
            </div>
            <div class="meta-item">
                <span class="meta-icon" aria-hidden="true"><ClockIcon /></span>
                <div class="meta-copy">
                    <div class="meta-label">Last signed in</div>
                    <div class="meta-value">@FormatRelative(CurrentUser.LastSignedIn)</div>
                    <div class="meta-relative">@FormatAbsolute(CurrentUser.LastSignedIn, includeTime: true)</div>
                </div>
            </div>
        </div>

        @if (CurrentUser.Providers.Any())
        {
            <div class="hero-providers">
                @foreach (var provider in CurrentUser.Providers.Distinct())
                {
                    <span class="provider-badge">@FormatProviderName(provider)</span>
                }
            </div>
        }
    </div>

    <div class="feature-grid">
        <button type="button" class="feature-card" @onclick='() => Navigate("Profile")'>
            <span class="feature-icon" aria-hidden="true"><PersonIcon /></span>
            <span class="feature-copy">
                <span class="feature-title">Profile</span>
                <span class="feature-stat">Your name, photo, and regional settings — plus @ContactSummary().</span>
            </span>
            <span class="feature-chevron" aria-hidden="true"><ChevronRightIcon /></span>
        </button>

        @if (EnableWorkspaces)
        {
            <button type="button" class="feature-card" @onclick='() => Navigate("Workspaces")'>
                <span class="feature-icon" aria-hidden="true"><BuildingIcon /></span>
                <span class="feature-copy">
                    <span class="feature-title">@WorkspaceLabelPlural</span>
                    <span class="feature-stat">Teams you belong to and their members — @(_loadingWorkspaces ? "loading…" : WorkspacesSummary()).</span>
                </span>
                <span class="feature-chevron" aria-hidden="true"><ChevronRightIcon /></span>
            </button>
        }

        @if (CurrentUser.IsGlobalAdmin)
        {
            <button type="button" class="feature-card" @onclick='() => Navigate("Admin")'>
                <span class="feature-icon" aria-hidden="true"><ShieldCheckIcon /></span>
                <span class="feature-copy">
                    <span class="feature-title">Administration</span>
                    <span class="feature-stat">Manage every user, role, and access level across this CloudLogin host.</span>
                </span>
                <span class="feature-chevron" aria-hidden="true"><ChevronRightIcon /></span>
            </button>
        }
    </div>

    @if (CurrentUser.IsTest)
    {
        <div class="card danger-card">
            <div class="card-header">
                <h4>Danger zone</h4>
            </div>
            <div class="danger-row">
                <div class="danger-copy">
                    <p class="danger-title">Delete this account</p>
                    <p class="danger-desc">Permanently deletes this test account and all of its data. This action can't be undone.</p>
                </div>
                @if (!_confirmingDelete)
                {
                    <button type="button" class="btn btn-danger" @onclick="() => _confirmingDelete = true">
                        <span class="btn-icon" aria-hidden="true"><TrashIcon /></span>
                        Delete account
                    </button>
                }
                else
                {
                    <div class="danger-confirm">
                        <span>Are you sure? This can't be undone.</span>
                        <button type="button" class="btn btn-danger btn-sm" @onclick="ConfirmDelete" disabled="@_deleting">
                            @(_deleting ? "Deleting…" : "Yes, delete")
                        </button>
                        <button type="button" class="btn btn-outline btn-sm" @onclick="() => _confirmingDelete = false" disabled="@_deleting">Cancel</button>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public required CloudUserModel CurrentUser { get; set; }
    [Parameter] public bool EnableWorkspaces { get; set; }

    /// <summary>Display name for one workspace (e.g. "Organization", "Business"). Defaults to "Workspace".</summary>
    [Parameter] public string WorkspaceLabel { get; set; } = "Workspace";

    /// <summary>Display name for many workspaces (e.g. "Organizations", "Businesses"). Defaults to "Workspaces".</summary>
    [Parameter] public string WorkspaceLabelPlural { get; set; } = "Workspaces";

    [Parameter] public EventCallback<string> OnNavigateToTab { get; set; }
    [Parameter] public EventCallback OnDeleteAccount { get; set; }

    private bool _loadingWorkspaces;
    private int _workspaceCount;

    private bool _confirmingDelete;
    private bool _deleting;

    protected override async Task OnInitializedAsync()
    {
        List<Task> tasks = [];

        if (EnableWorkspaces)
            tasks.Add(LoadWorkspacesAsync());

        if (tasks.Count > 0)
            await Task.WhenAll(tasks);
    }

    private async Task LoadWorkspacesAsync()
    {
        _loadingWorkspaces = true;
        _workspaceCount = (await cloudLogin.GetMyWorkspaces()).Count;
        _loadingWorkspaces = false;
    }

    private string WorkspacesSummary()
        => _workspaceCount == 0 ? "you're not a member of any yet" : $"{_workspaceCount} joined";

    private string ContactSummary()
    {
        int emails = CurrentUser.EmailAddresses.Count;
        int phones = CurrentUser.PhoneNumbers.Count;

        string emailPart = $"{emails} email address{(emails == 1 ? "" : "es")}";

        return phones == 0
            ? emailPart
            : $"{emailPart} and {phones} phone number{(phones == 1 ? "" : "s")}";
    }

    private async Task Navigate(string tab) => await OnNavigateToTab.InvokeAsync(tab);

    private async Task ConfirmDelete()
    {
        if (_deleting)
            return;

        _deleting = true;
        StateHasChanged();

        try
        {
            await OnDeleteAccount.InvokeAsync();
        }
        catch
        {
            // The parent already recorded this in the account-wide error center; here we
            // only need to stop the button spinning forever and let the user try again.
            _deleting = false;
            StateHasChanged();
        }
    }

    private string GetDisplayName()
    {
        string? full = CurrentUser.DisplayName;
        if (string.IsNullOrWhiteSpace(full))
            full = string.Join(" ", new[] { CurrentUser.FirstName, CurrentUser.LastName }.Where(s => !string.IsNullOrWhiteSpace(s)));
        return string.IsNullOrWhiteSpace(full) ? "Account" : full!;
    }

    private string GetPrimaryEmail()
        => (CurrentUser.PrimaryEmailAddress ?? CurrentUser.EmailAddresses.FirstOrDefault())?.Input ?? "No email on file";

    private string GetInitials()
    {
        var parts = new[] { CurrentUser.FirstName, CurrentUser.LastName }
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!.Trim());
        var initials = string.Concat(parts.Select(p => char.ToUpperInvariant(p[0])));
        if (string.IsNullOrWhiteSpace(initials) && !string.IsNullOrWhiteSpace(CurrentUser.DisplayName))
            initials = new string(CurrentUser.DisplayName!.Where(char.IsLetter).Take(2).Select(char.ToUpperInvariant).ToArray());
        return string.IsNullOrWhiteSpace(initials) ? "?" : initials;
    }

    /// <summary>
    /// The culture used to render dates, honouring the regional format the user picked on
    /// the Profile tab and falling back to the browser's culture. Cultures the runtime only
    /// synthesizes (trimmed ICU accepts well-formed but unknown tags) are rejected, since
    /// they'd silently format as invariant.
    /// </summary>
    private CultureInfo DisplayCulture
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(CurrentUser.Locale))
                try
                {
                    CultureInfo culture = CultureInfo.GetCultureInfo(CurrentUser.Locale);

                    const int LocaleCustomUnspecified = 0x1000;

                    if (!string.IsNullOrEmpty(culture.Name) && culture.LCID != LocaleCustomUnspecified)
                        return culture;
                }
                catch (CultureNotFoundException) { }

            return CultureInfo.CurrentCulture;
        }
    }

    /// <summary>
    /// Human-friendly elapsed time. Rounds to whole units and names the very recent and the
    /// near-past ("Right now", "Yesterday") rather than emitting a bare "0 minutes ago".
    /// </summary>
    private static string FormatRelative(DateTimeOffset dateTime)
    {
        if (dateTime == DateTimeOffset.MinValue)
            return "Not available";

        TimeSpan ago = DateTimeOffset.UtcNow - dateTime;

        // A clock a little ahead of the server shouldn't render as a negative age.
        if (ago < TimeSpan.Zero)
            ago = TimeSpan.Zero;

        if (ago.TotalSeconds < 45)
            return "Right now";

        if (ago.TotalMinutes < 2)
            return "A minute ago";

        if (ago.TotalMinutes < 60)
            return $"{(int)ago.TotalMinutes} minutes ago";

        if (ago.TotalHours < 2)
            return "An hour ago";

        if (ago.TotalHours < 24)
            return $"{(int)ago.TotalHours} hours ago";

        if (ago.TotalDays < 2)
            return "Yesterday";

        if (ago.TotalDays < 7)
            return $"{(int)ago.TotalDays} days ago";

        if (ago.TotalDays < 14)
            return "Last week";

        if (ago.TotalDays < 30)
            return $"{(int)(ago.TotalDays / 7)} weeks ago";

        if (ago.TotalDays < 60)
            return "Last month";

        if (ago.TotalDays < 365)
            return $"{(int)(ago.TotalDays / 30)} months ago";

        if (ago.TotalDays < 730)
            return "Last year";

        return $"{(int)(ago.TotalDays / 365)} years ago";
    }

    /// <summary>The exact date, in the user's regional format and local time zone.</summary>
    private string FormatAbsolute(DateTimeOffset dateTime, bool includeTime)
    {
        if (dateTime == DateTimeOffset.MinValue)
            return "Not available";

        // "D" = long date, "f" = long date plus short time.
        return dateTime.ToLocalTime().ToString(includeTime ? "f" : "D", DisplayCulture);
    }

    private static string FormatProviderName(string provider)
    {
        return provider.ToLowerInvariant() switch
        {
            "microsoft" => "Microsoft",
            "google" => "Google",
            "facebook" => "Facebook",
            "twitter" => "Twitter",
            "whatsapp" => "WhatsApp",
            "code" => "Email/SMS Code",
            "password" => "Password",
            _ => provider
        };
    }
}
