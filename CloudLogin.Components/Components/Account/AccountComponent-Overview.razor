@using AngryMonkey.CloudLogin.Interfaces
@using AngryMonkey.CloudLogin.Models
@using System.Globalization
@inject ICloudLogin cloudLogin

@namespace AngryMonkey.CloudLogin

<div class="account-section overview-page">
    @* ── Your info ───────────────────────────────────────── *@
    <section class="card section-card">
        <header class="section-card-header">
            <span class="section-card-icon" aria-hidden="true"><PersonIcon /></span>
            <div class="section-card-heading">
                <h4 class="section-card-title">Your info</h4>
                <p class="section-card-subtitle">Your name, photo, contact details, and regional settings</p>
            </div>
            <div class="section-card-actions">
                <button type="button" class="section-card-link" @onclick='() => Navigate("Profile")'>Edit profile</button>
                <button type="button" class="section-card-toggle" aria-expanded="@AriaExpanded(InfoSection)" aria-label="@ToggleLabel(InfoSection, "your info")" @onclick="() => Toggle(InfoSection)">
                    @if (IsOpen(InfoSection))
                    {
                        <ChevronUpIcon />
                    }
                    else
                    {
                        <ChevronDownIcon />
                    }
                </button>
            </div>
        </header>

        @if (IsOpen(InfoSection))
        {
            <div class="section-card-body">
                <div class="identity-row">
                    <div class="hero-identity">
                        @if (!string.IsNullOrWhiteSpace(CurrentUser.ProfilePicture))
                        {
                            <img class="hero-avatar" src="@CurrentUser.ProfilePicture" alt="Profile picture" />
                        }
                        else
                        {
                            <div class="hero-avatar initials" aria-hidden="true">@GetInitials()</div>
                        }
                        <div class="hero-identity-copy">
                            <div class="hero-name">@GetDisplayName()</div>
                            <div class="hero-email">@GetPrimaryEmail()</div>
                            @if (CurrentUser.IsLocked)
                            {
                                <span class="chip chip--locked">Locked</span>
                            }
                            else
                            {
                                <span class="chip chip--active">Active</span>
                            }
                        </div>
                    </div>

                    <div class="hero-meta">
                        <div class="meta-item">
                            <span class="meta-icon" aria-hidden="true"><CalendarIcon /></span>
                            <div class="meta-copy">
                                <div class="meta-label">Member since</div>
                                <div class="meta-value">@FormatAbsolute(CurrentUser.CreatedOn, includeTime: false)</div>
                                <div class="meta-relative">@FormatRelative(CurrentUser.CreatedOn)</div>
                            </div>
                        </div>
                        <div class="meta-item">
                            <span class="meta-icon" aria-hidden="true"><ClockIcon /></span>
                            <div class="meta-copy">
                                <div class="meta-label">Last signed in</div>
                                <div class="meta-value">@FormatRelative(CurrentUser.LastSignedIn)</div>
                                <div class="meta-relative">@FormatAbsolute(CurrentUser.LastSignedIn, includeTime: true)</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </section>

    @* ── Security ────────────────────────────────────────── *@
    <section class="card section-card">
        <header class="section-card-header">
            <span class="section-card-icon" aria-hidden="true"><ShieldIcon /></span>
            <div class="section-card-heading">
                <h4 class="section-card-title">Security</h4>
                <p class="section-card-subtitle">Password, authenticator app, passkeys, and the ways you sign in</p>
            </div>
            <div class="section-card-actions">
                <button type="button" class="section-card-link" @onclick='() => Navigate("Security")'>Manage security</button>
                <button type="button" class="section-card-toggle" aria-expanded="@AriaExpanded(SecuritySection)" aria-label="@ToggleLabel(SecuritySection, "security")" @onclick="() => Toggle(SecuritySection)">
                    @if (IsOpen(SecuritySection))
                    {
                        <ChevronUpIcon />
                    }
                    else
                    {
                        <ChevronDownIcon />
                    }
                </button>
            </div>
        </header>

        @if (IsOpen(SecuritySection))
        {
            <div class="section-card-body">
                @{
                    List<string> providers = [.. CurrentUser.Providers.Distinct()];
                }
                <div class="security-summary">
                    <div class="security-stat">
                        <span class="security-stat-value">@providers.Count</span>
                        <span class="security-stat-label">@(providers.Count == 1 ? "sign-in method" : "sign-in methods")</span>
                    </div>
                    @if (providers.Count > 0)
                    {
                        <div class="hero-providers">
                            @foreach (string provider in providers)
                            {
                                <span class="provider-badge">@FormatProviderName(provider)</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="section-note">No sign-in method is linked yet. Add a password or connect a provider so you can always get back in.</p>
                    }
                </div>
                <div class="section-actions">
                    <button type="button" class="btn btn-primary" @onclick='() => Navigate("Security")'>Change password</button>
                </div>
            </div>
        }
    </section>

    @* ── Devices ─────────────────────────────────────────── *@
    <section class="card section-card">
        <header class="section-card-header">
            <span class="section-card-icon" aria-hidden="true"><LaptopIcon /></span>
            <div class="section-card-heading">
                <h4 class="section-card-title">Devices</h4>
                <p class="section-card-subtitle">Find, sign out, and manage the devices signed in to your account</p>
            </div>
            <div class="section-card-actions">
                @if (!_loadingDevices)
                {
                    <button type="button" class="section-card-link" @onclick='() => Navigate("Devices")'>View all devices (@_devices.Count)</button>
                }
                <button type="button" class="section-card-toggle" aria-expanded="@AriaExpanded(DevicesSection)" aria-label="@ToggleLabel(DevicesSection, "devices")" @onclick="() => Toggle(DevicesSection)">
                    @if (IsOpen(DevicesSection))
                    {
                        <ChevronUpIcon />
                    }
                    else
                    {
                        <ChevronDownIcon />
                    }
                </button>
            </div>
        </header>

        @if (IsOpen(DevicesSection))
        {
            <div class="section-card-body">
                @if (_loadingDevices)
                {
                    <div class="loading-spinner" role="status" aria-label="Loading devices"></div>
                }
                else if (_devices.Count == 0)
                {
                    <div class="empty-state">
                        <p>No signed-in devices to show. Applications you sign in to appear here.</p>
                    </div>
                }
                else
                {
                    <div class="device-grid">
                        @foreach (CloudLoginSignedInDevice device in FeaturedDevices)
                        {
                            <div class="device-tile">
                                <span class="device-art" aria-hidden="true">@DeviceTypeIcon(device)</span>
                                <div class="device-copy">
                                    <span class="device-name">@device.Name</span>
                                    <span class="device-meta">@DescribeDevice(device)</span>
                                    <button type="button" class="section-card-link device-link" @onclick='() => Navigate("Devices")'>View details</button>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </section>

    @* ── Workspaces ──────────────────────────────────────── *@
    @if (EnableWorkspaces)
    {
        <section class="card section-card">
            <header class="section-card-header">
                <span class="section-card-icon" aria-hidden="true"><BuildingIcon /></span>
                <div class="section-card-heading">
                    <h4 class="section-card-title">@WorkspaceLabelPlural</h4>
                    <p class="section-card-subtitle">Teams you belong to and their members</p>
                </div>
                <div class="section-card-actions">
                    <button type="button" class="section-card-link" @onclick='() => Navigate("Workspaces")'>View all</button>
                    <button type="button" class="section-card-toggle" aria-expanded="@AriaExpanded(WorkspacesSection)" aria-label="@ToggleLabel(WorkspacesSection, WorkspaceLabelPlural.ToLowerInvariant())" @onclick="() => Toggle(WorkspacesSection)">
                        @if (IsOpen(WorkspacesSection))
                        {
                            <ChevronUpIcon />
                        }
                        else
                        {
                            <ChevronDownIcon />
                        }
                    </button>
                </div>
            </header>

            @if (IsOpen(WorkspacesSection))
            {
                <div class="section-card-body">
                    <p class="section-note">@(_loadingWorkspaces ? "Loading…" : WorkspacesSummary())</p>
                </div>
            }
        </section>
    }

    @* ── Administration ──────────────────────────────────── *@
    @if (CurrentUser.IsGlobalAdmin)
    {
        <section class="card section-card">
            <header class="section-card-header">
                <span class="section-card-icon" aria-hidden="true"><ShieldCheckIcon /></span>
                <div class="section-card-heading">
                    <h4 class="section-card-title">Administration</h4>
                    <p class="section-card-subtitle">Manage every user, role, and access level across this CloudLogin host</p>
                </div>
                <div class="section-card-actions">
                    <button type="button" class="section-card-link" @onclick='() => Navigate("Admin")'>Open administration</button>
                    <button type="button" class="section-card-toggle" aria-expanded="@AriaExpanded(AdminSection)" aria-label="@ToggleLabel(AdminSection, "administration")" @onclick="() => Toggle(AdminSection)">
                        @if (IsOpen(AdminSection))
                        {
                            <ChevronUpIcon />
                        }
                        else
                        {
                            <ChevronDownIcon />
                        }
                    </button>
                </div>
            </header>

            @if (IsOpen(AdminSection))
            {
                <div class="section-card-body">
                    <p class="section-note">You're a global administrator on this host. Review accounts, lock or unlock users, and grant or revoke administrator access.</p>
                    <div class="section-actions">
                        <button type="button" class="btn btn-primary" @onclick='() => Navigate("Admin")'>Open administration</button>
                    </div>
                </div>
            }
        </section>
    }

    @* ── Danger zone ─────────────────────────────────────── *@
    @if (CurrentUser.IsTest)
    {
        <section class="card section-card danger-card">
            <header class="section-card-header">
                <span class="section-card-icon danger-icon" aria-hidden="true"><AlertTriangleIcon /></span>
                <div class="section-card-heading">
                    <h4 class="section-card-title">Danger zone</h4>
                    <p class="section-card-subtitle">Actions here can't be undone</p>
                </div>
            </header>
            <div class="section-card-body">
                <div class="danger-row">
                    <div class="danger-copy">
                        <p class="danger-title">Delete this account</p>
                        <p class="danger-desc">Permanently deletes this test account and all of its data.</p>
                    </div>
                    @if (!_confirmingDelete)
                    {
                        <button type="button" class="btn btn-danger" @onclick="() => _confirmingDelete = true">
                            <span class="btn-icon" aria-hidden="true"><TrashIcon /></span>
                            Delete account
                        </button>
                    }
                    else
                    {
                        <div class="danger-confirm">
                            <span>Are you sure? This can't be undone.</span>
                            <button type="button" class="btn btn-danger btn-sm" @onclick="ConfirmDelete" disabled="@_deleting">
                                @(_deleting ? "Deleting…" : "Yes, delete")
                            </button>
                            <button type="button" class="btn btn-outline btn-sm" @onclick="() => _confirmingDelete = false" disabled="@_deleting">Cancel</button>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
</div>

@code {
    [Parameter] public required CloudUserModel CurrentUser { get; set; }
    [Parameter] public bool EnableWorkspaces { get; set; }

    /// <summary>Display name for one workspace (e.g. "Organization", "Business"). Defaults to "Workspace".</summary>
    [Parameter] public string WorkspaceLabel { get; set; } = "Workspace";

    /// <summary>Display name for many workspaces (e.g. "Organizations", "Businesses"). Defaults to "Workspaces".</summary>
    [Parameter] public string WorkspaceLabelPlural { get; set; } = "Workspaces";

    [Parameter] public EventCallback<string> OnNavigateToTab { get; set; }
    [Parameter] public EventCallback OnDeleteAccount { get; set; }

    [CascadingParameter] private AccountErrorCenter? ErrorCenter { get; set; }

    private const string InfoSection = "info";
    private const string SecuritySection = "security";
    private const string DevicesSection = "devices";
    private const string WorkspacesSection = "workspaces";
    private const string AdminSection = "admin";

    /// <summary>The most devices the overview shows before deferring to the Devices tab.</summary>
    private const int FeaturedDeviceCount = 3;

    // Every section starts open; the chevron in its header folds it away for this visit only.
    private readonly HashSet<string> _collapsed = [];

    private bool _loadingWorkspaces;
    private int _workspaceCount;

    private bool _loadingDevices = true;
    private List<CloudLoginSignedInDevice> _devices = [];

    private bool _confirmingDelete;
    private bool _deleting;

    protected override async Task OnInitializedAsync()
    {
        List<Task> tasks = [LoadDevicesAsync()];

        if (EnableWorkspaces)
            tasks.Add(LoadWorkspacesAsync());

        await Task.WhenAll(tasks);
    }

    private async Task LoadWorkspacesAsync()
    {
        _loadingWorkspaces = true;
        _workspaceCount = (await cloudLogin.GetMyWorkspaces()).Count;
        _loadingWorkspaces = false;
    }

    private async Task LoadDevicesAsync()
    {
        try
        {
            _devices = await cloudLogin.GetMyDevices();
        }
        catch (Exception exception)
        {
            // A failed device list should not take the rest of the overview down with it; the
            // card shows its empty state and the rail's error pill says what went wrong.
            ErrorCenter?.Report("Overview — Devices", $"Failed to load your devices: {exception.Message}", exception);
        }
        finally
        {
            _loadingDevices = false;
        }
    }

    /// <summary>
    /// The devices worth a tile: signed-in ones first, this device ahead of the rest, then
    /// the most recently active - capped so the card stays a summary of the Devices tab.
    /// </summary>
    private IEnumerable<CloudLoginSignedInDevice> FeaturedDevices => _devices
        .OrderByDescending(device => device.IsActive)
        .ThenByDescending(device => device.IsCurrent)
        .ThenByDescending(device => device.LastSeenOn ?? device.SignedInOn)
        .Take(FeaturedDeviceCount);

    private bool IsOpen(string section) => !_collapsed.Contains(section);

    private void Toggle(string section)
    {
        if (!_collapsed.Remove(section))
            _collapsed.Add(section);
    }

    private string AriaExpanded(string section) => IsOpen(section) ? "true" : "false";

    private string ToggleLabel(string section, string subject) => IsOpen(section) ? $"Collapse {subject}" : $"Expand {subject}";

    private static RenderFragment DeviceTypeIcon(CloudLoginSignedInDevice device) => device.Type switch
    {
        "Mobile" => @<PhoneIcon />,
        "Tablet" => @<TabletIcon />,
        "Desktop" => @<LaptopIcon />,
        _ => @<DesktopIcon />
    };

    private static string DescribeDevice(CloudLoginSignedInDevice device)
    {
        if (device.IsCurrent)
            return "This device";

        if (!device.IsActive)
            return "Signed out";

        return $"Last active {FormatRelative(device.LastSeenOn ?? device.SignedInOn).ToLowerInvariant()}";
    }

    private string WorkspacesSummary()
        => _workspaceCount == 0
            ? $"You're not a member of any {WorkspaceLabelPlural.ToLowerInvariant()} yet."
            : $"You belong to {_workspaceCount} {(_workspaceCount == 1 ? WorkspaceLabel.ToLowerInvariant() : WorkspaceLabelPlural.ToLowerInvariant())}.";

    private async Task Navigate(string tab) => await OnNavigateToTab.InvokeAsync(tab);

    private async Task ConfirmDelete()
    {
        if (_deleting)
            return;

        _deleting = true;
        StateHasChanged();

        try
        {
            await OnDeleteAccount.InvokeAsync();
        }
        catch
        {
            // The parent already recorded this in the account-wide error center; here we
            // only need to stop the button spinning forever and let the user try again.
            _deleting = false;
            StateHasChanged();
        }
    }

    private string GetDisplayName()
    {
        string? full = CurrentUser.DisplayName;
        if (string.IsNullOrWhiteSpace(full))
            full = string.Join(" ", new[] { CurrentUser.FirstName, CurrentUser.LastName }.Where(s => !string.IsNullOrWhiteSpace(s)));
        return string.IsNullOrWhiteSpace(full) ? "Account" : full!;
    }

    private string GetPrimaryEmail()
        => (CurrentUser.PrimaryEmailAddress ?? CurrentUser.EmailAddresses.FirstOrDefault())?.Input ?? "No email on file";

    private string GetInitials()
    {
        IEnumerable<string> parts = new[] { CurrentUser.FirstName, CurrentUser.LastName }
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!.Trim());
        string initials = string.Concat(parts.Select(p => char.ToUpperInvariant(p[0])));
        if (string.IsNullOrWhiteSpace(initials) && !string.IsNullOrWhiteSpace(CurrentUser.DisplayName))
            initials = new string(CurrentUser.DisplayName!.Where(char.IsLetter).Take(2).Select(char.ToUpperInvariant).ToArray());
        return string.IsNullOrWhiteSpace(initials) ? "?" : initials;
    }

    /// <summary>
    /// The culture used to render dates, honouring the regional format the user picked on
    /// the Profile tab and falling back to the browser's culture. Cultures the runtime only
    /// synthesizes (trimmed ICU accepts well-formed but unknown tags) are rejected, since
    /// they'd silently format as invariant.
    /// </summary>
    private CultureInfo DisplayCulture
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(CurrentUser.Locale))
                try
                {
                    CultureInfo culture = CultureInfo.GetCultureInfo(CurrentUser.Locale);

                    const int LocaleCustomUnspecified = 0x1000;

                    if (!string.IsNullOrEmpty(culture.Name) && culture.LCID != LocaleCustomUnspecified)
                        return culture;
                }
                catch (CultureNotFoundException) { }

            return CultureInfo.CurrentCulture;
        }
    }

    /// <summary>
    /// Human-friendly elapsed time. Rounds to whole units and names the very recent and the
    /// near-past ("Right now", "Yesterday") rather than emitting a bare "0 minutes ago".
    /// </summary>
    private static string FormatRelative(DateTimeOffset dateTime)
    {
        if (dateTime == DateTimeOffset.MinValue)
            return "Not available";

        TimeSpan ago = DateTimeOffset.UtcNow - dateTime;

        // A clock a little ahead of the server shouldn't render as a negative age.
        if (ago < TimeSpan.Zero)
            ago = TimeSpan.Zero;

        if (ago.TotalSeconds < 45)
            return "Right now";

        if (ago.TotalMinutes < 2)
            return "A minute ago";

        if (ago.TotalMinutes < 60)
            return $"{(int)ago.TotalMinutes} minutes ago";

        if (ago.TotalHours < 2)
            return "An hour ago";

        if (ago.TotalHours < 24)
            return $"{(int)ago.TotalHours} hours ago";

        if (ago.TotalDays < 2)
            return "Yesterday";

        if (ago.TotalDays < 7)
            return $"{(int)ago.TotalDays} days ago";

        if (ago.TotalDays < 14)
            return "Last week";

        if (ago.TotalDays < 30)
            return $"{(int)(ago.TotalDays / 7)} weeks ago";

        if (ago.TotalDays < 60)
            return "Last month";

        if (ago.TotalDays < 365)
            return $"{(int)(ago.TotalDays / 30)} months ago";

        if (ago.TotalDays < 730)
            return "Last year";

        return $"{(int)(ago.TotalDays / 365)} years ago";
    }

    /// <summary>The exact date, in the user's regional format and local time zone.</summary>
    private string FormatAbsolute(DateTimeOffset dateTime, bool includeTime)
    {
        if (dateTime == DateTimeOffset.MinValue)
            return "Not available";

        // "D" = long date, "f" = long date plus short time.
        return dateTime.ToLocalTime().ToString(includeTime ? "f" : "D", DisplayCulture);
    }

    private static string FormatProviderName(string provider)
    {
        return provider.ToLowerInvariant() switch
        {
            "microsoft" => "Microsoft",
            "google" => "Google",
            "facebook" => "Facebook",
            "twitter" => "Twitter",
            "whatsapp" => "WhatsApp",
            "code" => "Email/SMS Code",
            "password" => "Password",
            _ => provider
        };
    }
}
