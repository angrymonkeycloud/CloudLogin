@using AngryMonkey.CloudLogin.Interfaces
@inject ICloudLogin cloudLogin

@namespace AngryMonkey.CloudLogin

@* Payment references for whichever account is in context — the signed-in user, or the
   organization they switched into. CloudLogin stores provider references only. *@

<div class="account-section">
    <div class="section-header">
        <h3>Payment options</h3>
        <p class="section-description">
            @(OrganizationId is null
                ? "Payment methods saved to your account."
                : "Payment methods this organization pays with.")
            CloudLogin stores only provider references &mdash; never card data.
        </p>
    </div>

    @if (_loading)
    {
        <div class="loading-spinner"></div>
    }
    else
    {
        @if (CanManage)
        {
            <div class="card">
                <div class="card-header">
                    <h4>Add a payment method</h4>
                </div>

                <div class="add-grid">
                    <div class="field">
                        <label class="field-label" for="pm-provider">Provider</label>
                        <select id="pm-provider" class="form-input" @bind="_newProvider" disabled="@_saving">
                            <option value="Stripe">Stripe</option>
                            <option value="MyFatoorah">MyFatoorah</option>
                            <option value="BankTransfer">Bank transfer</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="field">
                        <label class="field-label" for="pm-reference">Reference</label>
                        <input id="pm-reference" class="form-input" placeholder="e.g. pm_1NXa2b…" @bind="_newReference" @bind:event="oninput" disabled="@_saving" />
                    </div>
                    <div class="field">
                        <label class="field-label" for="pm-name">Display name (optional)</label>
                        <input id="pm-name" class="form-input" placeholder="Visa ending 4242" @bind="_newDisplayName" disabled="@_saving" />
                    </div>
                </div>

                <div class="add-actions">
                    <label class="input-check">
                        <input type="checkbox" @bind="_newIsDefault" disabled="@_saving" />
                        Set as default
                    </label>
                    <button class="btn btn-primary" @onclick="AddPaymentMethodAsync" disabled="@(_saving || string.IsNullOrWhiteSpace(_newReference))">
                        @(_saving ? "Saving…" : "Add payment method")
                    </button>
                </div>

                @if (!string.IsNullOrEmpty(_message))
                {
                    <div class="@(_success ? "alert-success" : "alert-error")" role="status">@_message</div>
                }
            </div>
        }
        else
        {
            <p class="read-only-note">Only the organization's owner or an admin can change its payment methods.</p>
        }

        if (_paymentMethods.Count == 0)
        {
            <div class="empty-state">
                <p>@(OrganizationId is null ? "You don't have any saved payment methods yet." : "This organization doesn't have any saved payment methods yet.")</p>
            </div>
        }
        else
        {
            <div class="items-list">
                @foreach (AccountPaymentMethodReference method in _paymentMethods)
                {
                    <div class="item-row">
                        <span class="item-icon" aria-hidden="true"><CreditCardIcon /></span>
                        <div class="item-copy">
                            <span class="item-text">@(method.DisplayName ?? method.Provider)</span>
                            <span class="item-meta">@method.Provider <span aria-hidden="true">&middot;</span> <code>@method.Reference</code></span>
                        </div>
                        <div class="item-actions">
                            @if (method.IsDefault)
                            {
                                <span class="badge badge-primary">Default</span>
                            }
                            @if (CanManage)
                            {
                                @if (_confirmingReference == method.Reference)
                                {
                                    <button class="btn btn-danger btn-sm" @onclick="() => RemoveAsync(method)" disabled="@_saving">
                                        @(_saving ? "Removing…" : "Remove")
                                    </button>
                                    <button class="btn btn-outline btn-sm" @onclick="() => _confirmingReference = null" disabled="@_saving">Cancel</button>
                                }
                                else
                                {
                                    <button class="btn btn-outline btn-sm" @onclick="() => StartRemove(method.Reference)" disabled="@_saving">Remove</button>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    /// <summary>The organization whose payment methods to show. Null shows the signed-in user's own.</summary>
    [Parameter] public Guid? OrganizationId { get; set; }

    /// <summary>The organization's billing profile, already loaded by the parent.</summary>
    [Parameter] public AccountBillingProfile? Profile { get; set; }

    /// <summary>Whether the viewer may add or remove methods. Organization members who aren't admins may not.</summary>
    [Parameter] public bool CanManage { get; set; } = true;

    /// <summary>Asks the parent to reload after a change, so its own counts stay right.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    [CascadingParameter] private AccountErrorCenter? ErrorCenter { get; set; }

    private List<AccountPaymentMethodReference> _paymentMethods = [];
    private bool _loading = true;
    private bool _loadedMine;

    private string _newProvider = "Stripe";
    private string _newReference = string.Empty;
    private string _newDisplayName = string.Empty;
    private bool _newIsDefault;
    private bool _saving;
    private string? _confirmingReference;
    private string _message = string.Empty;
    private bool _success;

    protected override async Task OnParametersSetAsync()
    {
        // An organization's profile arrives from the parent, which already fetched the whole
        // workspace, so it just re-reads. The personal profile is fetched once rather than on
        // every re-render the parent triggers; writes below refresh it from their response.
        if (OrganizationId is not null)
            _paymentMethods = Profile?.PaymentMethods.ToList() ?? [];
        else if (!_loadedMine)
        {
            AccountBillingProfile? profile = await cloudLogin.GetMyBillingProfile();
            _paymentMethods = profile?.PaymentMethods.ToList() ?? [];
            _loadedMine = true;
        }

        _loading = false;
    }

    private void StartRemove(string reference)
    {
        _confirmingReference = reference;
        _message = string.Empty;
    }

    private async Task AddPaymentMethodAsync()
    {
        if (_saving || string.IsNullOrWhiteSpace(_newReference))
            return;

        AccountPaymentMethodReference method = new(
            _newProvider,
            _newReference.Trim(),
            string.IsNullOrWhiteSpace(_newDisplayName) ? null : _newDisplayName.Trim(),
            _newIsDefault);

        await Submit("Payment method added.", "adding a payment method", async () =>
        {
            AccountBillingProfile profile = await cloudLogin.AddPaymentMethod(method, OrganizationId);
            _paymentMethods = profile.PaymentMethods.ToList();

            _newReference = string.Empty;
            _newDisplayName = string.Empty;
            _newIsDefault = false;
        });
    }

    private async Task RemoveAsync(AccountPaymentMethodReference method)
        => await Submit("Payment method removed.", "removing a payment method", async () =>
        {
            AccountBillingProfile profile = await cloudLogin.RemovePaymentMethod(method.Provider, method.Reference, OrganizationId);
            _paymentMethods = profile.PaymentMethods.ToList();
            _confirmingReference = null;
        });

    private async Task Submit(string successMessage, string action, Func<Task> operation)
    {
        if (_saving)
            return;

        try
        {
            _saving = true;
            _message = string.Empty;
            StateHasChanged();

            await operation();

            _message = successMessage;
            _success = true;

            await OnChanged.InvokeAsync();
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            _success = false;
            _confirmingReference = null;
            ErrorCenter?.Report("Payment options — " + action, exception.Message, exception);
        }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }
}
