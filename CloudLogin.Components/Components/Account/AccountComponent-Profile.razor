@using AngryMonkey.CloudLogin.Interfaces
@using AngryMonkey.CloudLogin.Models
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using AngryMonkey.Cloud
@using AngryMonkey.Cloud.Geography
@inject ICloudLogin cloudLogin

@namespace AngryMonkey.CloudLogin

<div class="account-section profile-page">
    <div class="section-header">
        <h3>Profile</h3>
        <p class="section-description">Your info, email addresses, and phone numbers. Everything here can only be edited from this page.</p>
    </div>

    <!-- Header card with avatar and name -->
    <div class="header-card">
        <div class="profile-block">
            <div class="avatar-wrap">
                @if (!string.IsNullOrWhiteSpace(CurrentUser.ProfilePicture))
                {
                    <img class="avatar" src="@CurrentUser.ProfilePicture" alt="Profile picture" />
                }
                else
                {
                    <div class="avatar initials" aria-hidden="true">@GetInitials()</div>
                }
                @if (_isUploadingPhoto)
                {
                    <div class="avatar-overlay">
                        <span class="loading-spinner"></span>
                    </div>
                }
            </div>

            <div class="profile-copy">
                <p class="subtitle">Personalize your account with a photo. Your profile photo may appear in apps and devices that use your account.</p>
                <div class="photo-actions">
                    <label class="btn btn-outline @(_isUploadingPhoto ? "is-disabled" : "")">
                        @if (_isUploadingPhoto)
                        {
                            <span class="loading-spinner"></span>
                            <span>Uploading...</span>
                        }
                        else
                        {
                            <span>Change photo</span>
                        }
                        <InputFile OnChange="OnPhotoSelected" accept="image/*" disabled="@_isUploadingPhoto" hidden />
                    </label>
                    @if (CurrentUser.IsCustomProfilePicture && !string.IsNullOrWhiteSpace(CurrentUser.ProfilePicture))
                    {
                        <button class="link-action link-danger" @onclick="RemovePhoto" disabled="@_isUploadingPhoto">Remove photo</button>
                    }
                </div>
                @if (!string.IsNullOrEmpty(_photoMessage))
                {
                    <div class="@(_photoSuccess ? "alert-success" : "alert-error") photo-message">
                        @_photoMessage
                    </div>
                }
            </div>
        </div>

        <div class="full-name-row">
            @if (_isEditingName)
            {
                <div class="edit-fields">
                    <input class="form-input" @bind="_editFirstName" placeholder="First name" />
                    <input class="form-input" @bind="_editLastName" placeholder="Last name" />
                    <input class="form-input" @bind="_editDisplayName" placeholder="Display name" />
                    <div class="edit-actions">
                        <button class="btn btn-primary btn-sm" @onclick="SaveName" disabled="@_isSaving">Save</button>
                        <button class="btn btn-outline btn-sm" @onclick="CancelEditName" disabled="@_isSaving">Cancel</button>
                    </div>
                </div>
            }
            else
            {
                <div class="full-name">@GetFullName()</div>
                <button class="link-action" @onclick="StartEditName">Edit name</button>
            }
        </div>
    </div>

    <!-- Profile info card -->
    <div class="card info-card">
        <div class="card-header">
            <h4>Profile info</h4>
            @if (_isEditingProfile)
            {
                <div class="edit-actions">
                    <button class="btn btn-primary btn-sm" @onclick="SaveProfile" disabled="@_isSaving">Save</button>
                    <button class="btn btn-outline btn-sm" @onclick="CancelEditProfile" disabled="@_isSaving">Cancel</button>
                </div>
            }
            else
            {
                <button class="link-action" @onclick="StartEditProfile">Edit profile info</button>
            }
        </div>
        <div class="kv-list">
            <div class="kv-row">
                <div class="kv-key">Date of birth</div>
                <div class="kv-value">
                    @if (_isEditingProfile)
                    {
                        <input type="date" class="form-input" @bind="_editDateOfBirth" />
                    }
                    else
                    {
                        @FormatDateOnly(CurrentUser.DateOfBirth)
                    }
                </div>
            </div>
            <div class="kv-row">
                <div class="kv-key">Country or region</div>
                <div class="kv-value">
                    @if (_isEditingProfile)
                    {
                        <select class="form-input" @bind="_editCountry" @bind:after="OnCountryChanged">
                            <option value="">Not specified</option>
                            @foreach (Country country in Countries)
                            {
                                <option value="@country.Code">@country.Name</option>
                            }
                        </select>
                    }
                    else
                    {
                        @FormatCountry(CurrentUser.Country)
                    }
                </div>
            </div>
            <div class="kv-row">
                <div class="kv-key">Language</div>
                <div class="kv-value">
                    @if (_isEditingProfile)
                    {
                        <select class="form-input" @bind="_editLanguage" @bind:after="OnLanguageChanged">
                            <option value="">Not specified</option>
                            @foreach (Language language in Languages)
                            {
                                <option value="@language.Code">
                                    @(language.Name == language.NativeName ? language.Name : $"{language.Name} — {language.NativeName}")
                                </option>
                            }
                        </select>
                    }
                    else
                    {
                        @FormatLanguage(CurrentUser.Locale)
                    }
                </div>
            </div>
            <div class="kv-row">
                <div class="kv-key">Regional format</div>
                <div class="kv-value">
                    @if (_isEditingProfile)
                    {
                        <select class="form-input" @bind="_editLocale">
                            <option value="">Not specified</option>
                            @foreach (RegionalFormatOption option in RegionalFormatOptions)
                            {
                                <option value="@option.Code">@option.Label</option>
                            }
                        </select>
                        @if (FormatSample(_editLocale) is { Length: > 0 } sample)
                        {
                            <p class="field-preview">Dates and numbers will look like: <strong>@sample</strong></p>
                        }
                    }
                    else
                    {
                        @FormatRegionalFormats(CurrentUser.Locale)
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="@(_operationSuccess ? "alert-success" : "alert-error")">
            @_statusMessage
        </div>
    }

    <AccountComponent_Emails CurrentUser="CurrentUser" />

    <AccountComponent_Numbers CurrentUser="CurrentUser" />
</div>

@code {
    [Parameter] public required CloudUserModel CurrentUser { get; set; }

    [CascadingParameter] private AccountErrorCenter? ErrorCenter { get; set; }

    // Photo upload state
    private bool _isUploadingPhoto = false;
    private string _photoMessage = string.Empty;
    private bool _photoSuccess = false;

    // Name editing state
    private bool _isEditingName = false;
    private string? _editFirstName;
    private string? _editLastName;
    private string? _editDisplayName;

    // Profile editing state
    private bool _isEditingProfile = false;
    private DateTime? _editDateOfBirth;
    private string? _editCountry;
    private string? _editLanguage;
    private string? _editLocale;

    private bool _isSaving = false;
    private string _statusMessage = string.Empty;
    private bool _operationSuccess = false;

    private const long MaxPhotoBytes = 5 * 1024 * 1024; // 5 MB

    // CloudGeography's country and language tables are static data that needs no API key
    // (only its reverse-geocoding helpers require one), so a plain client instance is enough
    // to back these dropdowns. Shared across instances since the lists never change.
    private static readonly CloudGeographyClient Geography = new();
    private static List<Country>? _countries;
    private static List<Language>? _languages;

    private static List<Country> Countries =>
        _countries ??= [.. Geography.Countries.Get().OrderBy(c => c.Name, StringComparer.OrdinalIgnoreCase)];

    private static List<Language> Languages =>
        _languages ??= [.. Geography.Languages.Get().OrderBy(l => l.Name, StringComparer.OrdinalIgnoreCase)];

    private sealed record RegionalFormatOption(string Code, string Label);

    /// <summary>
    /// Locale choices for the "Regional format" field. Built from the selected language and
    /// country rather than <see cref="CultureInfo.GetCultures"/>, because Blazor WebAssembly
    /// commonly ships a trimmed ICU dataset where enumerating every culture is unreliable.
    /// Anything the runtime can't actually resolve is dropped, so every option here formats.
    /// </summary>
    private List<RegionalFormatOption> RegionalFormatOptions
    {
        get
        {
            List<string> candidates = [];

            void AddCandidate(string? code)
            {
                if (!string.IsNullOrWhiteSpace(code) && !candidates.Contains(code, StringComparer.OrdinalIgnoreCase))
                    candidates.Add(code);
            }

            // The combination the user is actively choosing takes priority.
            if (!string.IsNullOrWhiteSpace(_editLanguage) && !string.IsNullOrWhiteSpace(_editCountry))
                AddCandidate($"{_editLanguage!.ToLowerInvariant()}-{_editCountry!.ToUpperInvariant()}");

            // Every language spoken in the selected country. Each code is validated against
            // the language table first: a few countries in CloudGeography's dataset carry
            // stray non-language codes (currency codes, for one) in their Languages list,
            // and pairing one of those with a country yields a locale that looks plausible
            // but silently formats as invariant.
            if (!string.IsNullOrWhiteSpace(_editCountry))
            {
                Country? country = Geography.Countries.Get(_editCountry!);
                if (country?.Languages is not null)
                    foreach (CountryLanguage countryLanguage in country.Languages)
                    {
                        Language? language = Geography.Languages.Get(countryLanguage.Code ?? string.Empty);
                        if (language is not null)
                            AddCandidate($"{language.Code.ToLowerInvariant()}-{country.Code.ToUpperInvariant()}");
                    }
            }

            // Whatever is already saved stays selectable even if it falls outside the above.
            AddCandidate(CurrentUser.Locale);
            AddCandidate(_editLocale);

            foreach (string common in CommonLocales)
                AddCandidate(common);

            List<RegionalFormatOption> options = [];

            foreach (string candidate in candidates)
            {
                CultureInfo? culture = TryGetCulture(candidate);
                if (culture is null)
                    continue;

                if (options.Any(o => o.Code.Equals(culture.Name, StringComparison.OrdinalIgnoreCase)))
                    continue;

                options.Add(new RegionalFormatOption(culture.Name, culture.DisplayName));
            }

            return options;
        }
    }

    private static readonly string[] CommonLocales =
    [
        "en-US", "en-GB", "en-CA", "en-AU", "fr-FR", "de-DE", "es-ES", "it-IT",
        "pt-BR", "nl-NL", "sv-SE", "da-DK", "nb-NO", "fi-FI", "pl-PL", "tr-TR",
        "ru-RU", "ar-SA", "he-IL", "hi-IN", "ja-JP", "ko-KR", "zh-CN", "zh-TW"
    ];

    private static CultureInfo? TryGetCulture(string? code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return null;

        try
        {
            CultureInfo culture = CultureInfo.GetCultureInfo(code);

            if (string.IsNullOrEmpty(culture.Name))
                return null;

            // Any well-formed tag is accepted rather than throwing — ICU synthesizes a
            // custom culture for names it doesn't actually know, which then formats as
            // invariant while still reporting a tidy DisplayName. LOCALE_CUSTOM_UNSPECIFIED
            // is how those synthesized cultures identify themselves, so drop them here
            // instead of offering the user a regional format that wouldn't take effect.
            const int LocaleCustomUnspecified = 0x1000;

            if (culture.LCID == LocaleCustomUnspecified)
                return null;

            return culture;
        }
        catch (CultureNotFoundException)
        {
            return null;
        }
    }

    /// <summary>Keeps the regional format aligned with the country the user just picked.</summary>
    private void OnCountryChanged() => RealignLocale();

    /// <summary>Keeps the regional format aligned with the language the user just picked.</summary>
    private void OnLanguageChanged() => RealignLocale();

    private void RealignLocale()
    {
        List<RegionalFormatOption> options = RegionalFormatOptions;

        // Drop a stale selection that no longer belongs to the chosen country/language,
        // then default to the best match so the field is never left showing nothing.
        if (!string.IsNullOrWhiteSpace(_editLocale) &&
            options.Any(o => o.Code.Equals(_editLocale, StringComparison.OrdinalIgnoreCase)))
            return;

        _editLocale = options.FirstOrDefault()?.Code ?? string.Empty;
    }

    private static string FormatSample(string? locale)
    {
        CultureInfo? culture = TryGetCulture(locale);

        if (culture is null)
            return string.Empty;

        try
        {
            return $"{DateTimeOffset.Now.ToString("d", culture)} · {1234567.89.ToString("N2", culture)}";
        }
        catch
        {
            return string.Empty;
        }
    }

    /// <summary>
    /// Handles selection of a new profile photo and uploads it to blob storage.
    /// </summary>
    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        if (_isUploadingPhoto)
            return;

        IBrowserFile file = e.File;

        if (file.Size > MaxPhotoBytes)
        {
            _photoMessage = "The selected image is too large (max 5 MB).";
            _photoSuccess = false;
            return;
        }

        try
        {
            _isUploadingPhoto = true;
            _photoMessage = string.Empty;
            StateHasChanged();

            using MemoryStream ms = new();
            await file.OpenReadStream(MaxPhotoBytes).CopyToAsync(ms);
            byte[] content = ms.ToArray();

            string contentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
            string url = await cloudLogin.UploadProfilePicture(CurrentUser.Id, content, contentType);

            CurrentUser.ProfilePicture = url;
            CurrentUser.IsCustomProfilePicture = true;

            _photoMessage = "Profile photo updated successfully.";
            _photoSuccess = true;
        }
        catch (Exception ex)
        {
            _photoMessage = $"Failed to update profile photo: {ex.Message}";
            _photoSuccess = false;
            ErrorCenter?.Report("Profile — Photo", _photoMessage, ex);
        }
        finally
        {
            _isUploadingPhoto = false;
            StateHasChanged();

            if (_photoSuccess)
            {
                await Task.Delay(3000);
                _photoMessage = string.Empty;
                StateHasChanged();
            }
        }
    }

    /// <summary>
    /// Removes the custom profile photo and reverts to the default provider image.
    /// </summary>
    private async Task RemovePhoto()
    {
        if (_isUploadingPhoto)
            return;

        try
        {
            _isUploadingPhoto = true;
            _photoMessage = string.Empty;
            StateHasChanged();

            CurrentUser.ProfilePicture = CurrentUser.ProviderProfilePicture;
            CurrentUser.IsCustomProfilePicture = false;

            await cloudLogin.UpdateUser(CurrentUser.ToContract());

            // Re-fetch to get the normalized default picture URL from the server.
            CloudUser? refreshed = await cloudLogin.CurrentUser();
            if (refreshed != null)
            {
                CurrentUser.ProfilePicture = refreshed.ProfilePicture;
                CurrentUser.ProviderProfilePicture = refreshed.ProviderProfilePicture;
                CurrentUser.IsCustomProfilePicture = refreshed.IsCustomProfilePicture;
            }

            _photoMessage = string.IsNullOrWhiteSpace(CurrentUser.ProfilePicture)
                ? "Profile photo removed."
                : "Your default photo has been restored.";
            _photoSuccess = true;
        }
        catch (Exception ex)
        {
            _photoMessage = $"Failed to remove profile photo: {ex.Message}";
            _photoSuccess = false;
            ErrorCenter?.Report("Profile — Photo", _photoMessage, ex);
        }
        finally
        {
            _isUploadingPhoto = false;
            StateHasChanged();

            if (_photoSuccess)
            {
                await Task.Delay(3000);
                _photoMessage = string.Empty;
                StateHasChanged();
            }
        }
    }

    private void StartEditName()
    {
        _editFirstName = CurrentUser.FirstName;
        _editLastName = CurrentUser.LastName;
        _editDisplayName = CurrentUser.DisplayName;
        _isEditingName = true;
    }

    private void CancelEditName() => _isEditingName = false;

    private async Task SaveName()
    {
        if (_isSaving)
            return;

        try
        {
            _isSaving = true;
            _statusMessage = string.Empty;
            StateHasChanged();

            CurrentUser.FirstName = _editFirstName?.Trim();
            CurrentUser.LastName = _editLastName?.Trim();
            CurrentUser.DisplayName = string.IsNullOrWhiteSpace(_editDisplayName)
                ? string.Join(" ", new[] { CurrentUser.FirstName, CurrentUser.LastName }.Where(s => !string.IsNullOrWhiteSpace(s)))
                : _editDisplayName.Trim();

            await cloudLogin.UpdateUser(CurrentUser.ToContract());

            _isEditingName = false;
            _statusMessage = "Name updated successfully.";
            _operationSuccess = true;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to update name: {ex.Message}";
            _operationSuccess = false;
            ErrorCenter?.Report("Profile — Name", _statusMessage, ex);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
            await ClearStatusMessageAfterDelay();
        }
    }

    private void StartEditProfile()
    {
        _editDateOfBirth = CurrentUser.DateOfBirth?.ToDateTime(TimeOnly.MinValue);
        _editCountry = NormalizeCountryCode(CurrentUser.Country);
        _editLocale = CurrentUser.Locale;
        _editLanguage = DeriveLanguageCode(CurrentUser.Locale);
        _isEditingProfile = true;
    }

    private void CancelEditProfile() => _isEditingProfile = false;

    /// <summary>Matches a stored country value to a known CloudGeography code so the select binds.</summary>
    private static string NormalizeCountryCode(string? stored)
        => string.IsNullOrWhiteSpace(stored) ? string.Empty : Geography.Countries.Get(stored)?.Code ?? string.Empty;

    /// <summary>Pulls the language half out of a stored locale (e.g. "en-US" -> "EN").</summary>
    private static string DeriveLanguageCode(string? locale)
    {
        if (string.IsNullOrWhiteSpace(locale))
            return string.Empty;

        string languagePart = locale.Split('-', '_')[0];
        return Geography.Languages.Get(languagePart)?.Code ?? string.Empty;
    }

    private async Task SaveProfile()
    {
        if (_isSaving)
            return;

        try
        {
            _isSaving = true;
            _statusMessage = string.Empty;
            StateHasChanged();

            CurrentUser.DateOfBirth = _editDateOfBirth.HasValue ? DateOnly.FromDateTime(_editDateOfBirth.Value) : null;
            CurrentUser.Country = string.IsNullOrWhiteSpace(_editCountry) ? null : _editCountry.Trim();
            CurrentUser.Locale = string.IsNullOrWhiteSpace(_editLocale) ? null : _editLocale.Trim();

            await cloudLogin.UpdateUser(CurrentUser.ToContract());

            _isEditingProfile = false;
            _statusMessage = "Profile info updated successfully.";
            _operationSuccess = true;
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to update profile info: {ex.Message}";
            _operationSuccess = false;
            ErrorCenter?.Report("Profile — Profile info", _statusMessage, ex);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
            await ClearStatusMessageAfterDelay();
        }
    }

    private async Task ClearStatusMessageAfterDelay()
    {
        if (_operationSuccess)
        {
            await Task.Delay(3000);
            _statusMessage = string.Empty;
            StateHasChanged();
        }
    }

    private string GetFullName()
    {
        var full = CurrentUser.DisplayName;
        if (string.IsNullOrWhiteSpace(full))
        {
            full = string.Join(" ", new[] { CurrentUser.FirstName, CurrentUser.LastName }
                .Where(s => !string.IsNullOrWhiteSpace(s)));
        }
        return string.IsNullOrWhiteSpace(full) ? "Not specified" : full!;
    }

    private string GetInitials()
    {
        var parts = new[] { CurrentUser.FirstName, CurrentUser.LastName }
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!.Trim());
        var initials = string.Concat(parts.Select(p => char.ToUpperInvariant(p[0])));
        if (string.IsNullOrWhiteSpace(initials) && !string.IsNullOrWhiteSpace(CurrentUser.DisplayName))
            initials = new string(CurrentUser.DisplayName!.Where(char.IsLetter).Take(2).Select(char.ToUpperInvariant).ToArray());
        return string.IsNullOrWhiteSpace(initials) ? "?" : initials;
    }

    private static string FormatDateOnly(DateOnly? date)
        => date.HasValue ? date.Value.ToString("M/d/yyyy") : "Not specified";

    private static string FormatCountry(string? countryCode)
    {
        if (string.IsNullOrWhiteSpace(countryCode))
            return "Not specified";

        return Geography.Countries.Get(countryCode)?.Name ?? countryCode;
    }

    private static string FormatLanguage(string? locale)
    {
        string languageCode = DeriveLanguageCode(locale);

        if (string.IsNullOrWhiteSpace(languageCode))
            return "Not specified";

        Language? language = Geography.Languages.Get(languageCode);

        if (language is null)
            return languageCode;

        return language.Name == language.NativeName
            ? language.Name
            : $"{language.Name} — {language.NativeName}";
    }

    private static string FormatRegionalFormats(string? locale)
    {
        CultureInfo? culture = TryGetCulture(locale);

        if (culture is null)
            return string.IsNullOrWhiteSpace(locale) ? "Not specified" : locale!;

        string sample = FormatSample(locale);

        return string.IsNullOrEmpty(sample) ? culture.DisplayName : $"{culture.DisplayName} · {sample}";
    }
}
