@using AngryMonkey.CloudLogin.Interfaces
@inject ICloudLogin cloudLogin

@namespace AngryMonkey.CloudLogin

<div class="account-section">
    <div class="section-header">
        <h3>Subscriptions</h3>
        <p class="section-description">Applications and plans linked to your account</p>
    </div>

    @if (_loading)
    {
        <div class="loading-spinner"></div>
    }
    else if (_subscriptions.Count == 0)
    {
        <div class="empty-state">You don't have any subscriptions yet.</div>
    }
    else
    {
        <div class="items-list">
            @foreach (var subscription in _subscriptions)
            {
                <div id="cloudlogin-subscription-@subscription.Id" class="item-row @(TargetSubscriptionId == subscription.Id ? "deep-link-target" : null)">
                    <div class="item-info">
                        <div class="item-copy">
                            <span class="item-text">@subscription.Application</span>
                            <span class="item-meta">
                                @subscription.Reference
                                <span aria-hidden="true">&middot;</span>
                                @(subscription.ExpiresOn?.ToString("MMMM dd, yyyy") ?? "No expiry")
                                @if (!string.IsNullOrWhiteSpace(subscription.Provider))
                                {
                                    <span aria-hidden="true">&middot;</span>
                                    @subscription.Provider
                                }
                            </span>
                        </div>
                        <span class="badge @StatusBadgeClass(subscription.Status)">@subscription.Status</span>
                    </div>
                    <div class="item-actions">
                        <span class="badge badge-info">Auto-renew @(subscription.AutoRenew ? "on" : "off")</span>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<AccountSubscription> _subscriptions = [];
    private bool _loading = true;
    [Parameter] public Guid? TargetSubscriptionId { get; set; }


    protected override async Task OnInitializedAsync()
    {
        _subscriptions = await cloudLogin.GetMySubscriptions();
        _loading = false;
    }

    private static string StatusBadgeClass(AccountSubscriptionStatuses status) => status switch
    {
        AccountSubscriptionStatuses.Active => "badge-primary",
        AccountSubscriptionStatuses.Pending => "badge-info",
        _ => "badge-secondary"
    };
}
