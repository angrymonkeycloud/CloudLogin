@using AngryMonkey.CloudLogin.Interfaces
@using AngryMonkey.CloudLogin.Models
@inject ICloudLogin cloudLogin

@namespace AngryMonkey.CloudLogin

@* One workspace, presented the way the personal account is: an identity header, its own
   information and billing details, its people, and a danger zone the owner alone can reach. *@

<div class="account-section workspace-page">
    <div class="section-header">
        <h3>@WorkspaceEntity.Name</h3>
        <p class="section-description">Everything this @WorkspaceLabelLower owns — its details, people, plans, and billing.</p>
    </div>

    <div class="card identity-card">
        <div class="identity">
            <div class="identity-mark" aria-hidden="true">@AccountDisplayHelpers.Initials(WorkspaceEntity.Name)</div>
            <div class="identity-copy">
                <div class="identity-name">@WorkspaceEntity.Name</div>
                <div class="identity-meta">
                    Created @WorkspaceEntity.CreatedOn.ToLocalTime().ToString("MMMM dd, yyyy")
                    @if (WorkspaceEntity.UpdatedOn is DateTimeOffset updated)
                    {
                        <span aria-hidden="true">&middot;</span>
                        <text>Updated @updated.ToLocalTime().ToString("MMMM dd, yyyy")</text>
                    }
                </div>
                <div class="identity-chips">
                    @if (Workspace.IsOwner)
                    {
                        <span class="chip chip--owner">Owner</span>
                    }
                    else
                    {
                        @foreach (string role in Workspace.Roles.Take(3))
                        {
                            <span class="chip">@role</span>
                        }
                        @if (Workspace.Roles.Count == 0)
                        {
                            <span class="chip">Member</span>
                        }
                    }
                </div>
            </div>
        </div>

        <div class="stat-row">
            <div class="stat _static">
                <span class="stat-value">@Workspace.Members.Count</span>
                <span class="stat-label">Member@(Workspace.Members.Count == 1 ? "" : "s")</span>
            </div>
        </div>
    </div>

    @* ── Information ──────────────────────────────────────── *@
    <div class="card">
        <div class="card-header">
            <h4>Information</h4>
            @if (Workspace.CanManage && !_editingProfile)
            {
                <button class="link-action" @onclick="StartProfileEdit" disabled="@_busy">Edit</button>
            }
        </div>

        @if (_editingProfile)
        {
            <div class="stack">
                <div class="field-grid">
                    <div class="field">
                        <label class="field-label" for="org-name">@WorkspaceLabel name</label>
                        <input id="org-name" class="form-input" @bind="_name" @bind:event="oninput" disabled="@_busy" />
                    </div>
                    <div class="field">
                        <label class="field-label" for="org-legal">Legal name</label>
                        <input id="org-legal" class="form-input" @bind="_legalName" placeholder="Registered entity name" disabled="@_busy" />
                    </div>
                    <div class="field">
                        <label class="field-label" for="org-website">Website</label>
                        <input id="org-website" class="form-input" @bind="_website" placeholder="https://example.com" disabled="@_busy" />
                    </div>
                </div>
                <div class="row-actions">
                    <button class="btn btn-primary" @onclick="SaveProfile" disabled="@(_busy || string.IsNullOrWhiteSpace(_name))">Save changes</button>
                    <button class="btn btn-outline" @onclick="() => _editingProfile = false" disabled="@_busy">Cancel</button>
                </div>
            </div>
        }
        else
        {
            <dl class="detail-list">
                <div class="detail-row">
                    <dt>@WorkspaceLabel name</dt>
                    <dd>@WorkspaceEntity.Name</dd>
                </div>
                <div class="detail-row">
                    <dt>Legal name</dt>
                    <dd class="@Muted(WorkspaceEntity.LegalName)">@Or(WorkspaceEntity.LegalName)</dd>
                </div>
                <div class="detail-row">
                    <dt>Website</dt>
                    <dd class="@Muted(WorkspaceEntity.Website)">@Or(WorkspaceEntity.Website)</dd>
                </div>
                <div class="detail-row">
                    <dt>@WorkspaceLabel Id</dt>
                    <dd><code class="identifier">@WorkspaceEntity.Id</code></dd>
                </div>
            </dl>
        }
    </div>

    @* ── Billing information ──────────────────────────────── *@
    @if (Workspace.CanManage)
    {
        <div class="card">
            <div class="card-header">
                <h4>Billing information</h4>
                @if (!_editingBilling)
                {
                    <button class="link-action" @onclick="StartBillingEdit" disabled="@_busy">Edit</button>
                }
            </div>

            @if (_editingBilling)
            {
                <div class="stack">
                    <div class="field-grid">
                        <div class="field _wide">
                            <label class="field-label" for="org-billing-additional">Additional billing information</label>
                            <textarea id="org-billing-additional" class="form-input" rows="3" @bind="_additionalBillingInformation"
                                      placeholder="Billing contact, department, PO reference - anything that should appear under the legal name" disabled="@_busy"></textarea>
                        </div>
                        <div class="field">
                            <label class="field-label" for="org-billing-email">Billing email</label>
                            <input id="org-billing-email" class="form-input" @bind="_billingEmail" placeholder="billing@company.com" disabled="@_busy" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="org-billing-phone">Billing phone</label>
                            <input id="org-billing-phone" class="form-input" @bind="_billingPhone" placeholder="+1 555 0100" disabled="@_busy" />
                        </div>
                        <div class="field">
                            <label class="field-label" for="org-tax">Tax / VAT number</label>
                            <input id="org-tax" class="form-input" @bind="_taxNumber" disabled="@_busy" />
                        </div>
                    </div>

                    <div class="field-group">
                        <span class="field-group-label">Billing address</span>
                        <div class="field-grid">
                            <div class="field _wide">
                                <label class="field-label" for="org-line1">Address line 1</label>
                                <input id="org-line1" class="form-input" @bind="_line1" disabled="@_busy" />
                            </div>
                            <div class="field _wide">
                                <label class="field-label" for="org-line2">Address line 2</label>
                                <input id="org-line2" class="form-input" @bind="_line2" disabled="@_busy" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="org-city">City</label>
                                <input id="org-city" class="form-input" @bind="_city" disabled="@_busy" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="org-state">State / region</label>
                                <input id="org-state" class="form-input" @bind="_state" disabled="@_busy" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="org-postal">Postal code</label>
                                <input id="org-postal" class="form-input" @bind="_postalCode" disabled="@_busy" />
                            </div>
                            <div class="field">
                                <label class="field-label" for="org-country">Country</label>
                                <input id="org-country" class="form-input" @bind="_country" disabled="@_busy" />
                            </div>
                        </div>
                    </div>

                    <div class="row-actions">
                        <button class="btn btn-primary" @onclick="SaveBilling" disabled="@_busy">Save changes</button>
                        <button class="btn btn-outline" @onclick="() => _editingBilling = false" disabled="@_busy">Cancel</button>
                    </div>
                </div>
            }
            else
            {
                <dl class="detail-list">
                    <div class="detail-row">
                        <dt>Additional billing information</dt>
                        <dd class="@Muted(WorkspaceEntity.AdditionalBillingInformation)">@Or(WorkspaceEntity.AdditionalBillingInformation)</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Billing email</dt>
                        <dd class="@Muted(WorkspaceEntity.BillingEmail)">@Or(WorkspaceEntity.BillingEmail)</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Billing phone</dt>
                        <dd class="@Muted(WorkspaceEntity.BillingPhone)">@Or(WorkspaceEntity.BillingPhone)</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Tax / VAT number</dt>
                        <dd class="@Muted(WorkspaceEntity.TaxNumber)">@Or(WorkspaceEntity.TaxNumber)</dd>
                    </div>
                    <div class="detail-row">
                        <dt>Billing address</dt>
                        <dd class="@(WorkspaceEntity.BillingAddress.IsEmpty ? "_muted" : null)">
                            @(WorkspaceEntity.BillingAddress.IsEmpty ? "Not specified" : WorkspaceEntity.BillingAddress.ToString())
                        </dd>
                    </div>
                </dl>
            }
        </div>
    }

    @* ── Members ──────────────────────────────────────────── *@
    <div class="card">
        <div class="card-header">
            <h4>Members</h4>
            <p class="card-description">@OwnershipSummary</p>
            @if (Workspace.CanManage && !_inviting)
            {
                <button class="link-action" @onclick="StartInvite" disabled="@_busy">Invite someone</button>
            }
        </div>

        @if (_inviting)
        {
            <div class="stack">
                <div class="field">
                    <label class="field-label" for="org-invite">Email address or phone number</label>
                    <input id="org-invite" class="form-input" @bind="_inviteRecipient" @bind:event="oninput" placeholder="teammate@company.com" disabled="@_busy" />
                </div>
                <div class="row-actions">
                    <button class="btn btn-primary" @onclick="SendInvite" disabled="@(_busy || string.IsNullOrWhiteSpace(_inviteRecipient))">Send invitation</button>
                    <button class="btn btn-outline" @onclick="() => _inviting = false" disabled="@_busy">Cancel</button>
                </div>
            </div>
        }

        <div class="entry-list">
            @foreach (CloudWorkspaceMemberProfileModel member in Workspace.Members)
            {
                <div class="entry-row">
                    @if (!string.IsNullOrWhiteSpace(member.ProfilePicture))
                    {
                        <img class="entry-avatar" src="@member.ProfilePicture" alt="" />
                    }
                    else
                    {
                        <span class="entry-avatar initials" aria-hidden="true">@AccountDisplayHelpers.Initials(member.Label)</span>
                    }
                    <div class="entry-copy">
                        <span class="entry-title">@member.Label</span>
                        <span class="entry-meta">
                            @if (!string.IsNullOrWhiteSpace(member.EmailAddress) && member.EmailAddress != member.Label)
                            {
                                @member.EmailAddress
                                <span aria-hidden="true">&middot;</span>
                            }
                            Joined @member.JoinedOn.ToLocalTime().ToString("MMMM dd, yyyy")
                        </span>
                    </div>
                    <div class="entry-tags">
                        @if (member.IsOwner)
                        {
                            <span class="chip chip--owner">Owner</span>
                        }
                        @foreach (string role in member.Roles.Where(role => !role.Equals("Owner", StringComparison.OrdinalIgnoreCase)))
                        {
                            <span class="chip">@role</span>
                        }
                        @if (member.State != CloudWorkspaceMembershipStates.Active)
                        {
                            <span class="chip chip--muted">@member.State</span>
                        }
                    </div>
                </div>
            }
        </div>
    </div>

    @* ── Danger zone ──────────────────────────────────────── *@
    @if (Workspace.Deletion is CloudWorkspaceDeletionReport report)
    {
        <div class="card danger-card">
            <div class="card-header">
                <h4>Delete @WorkspaceLabelLower</h4>
            </div>

            @if (!report.CanDelete)
            {
                <p class="card-note">This @WorkspaceLabelLower can't be deleted yet.</p>
                <ul class="blocker-list">
                    @foreach (string reason in report.Reasons)
                    {
                        <li>@reason</li>
                    }
                </ul>
            }
            else if (!_confirmingDelete)
            {
                <p class="card-note">
                    Deleting <strong>@WorkspaceEntity.Name</strong> permanently removes its billing details, saved payment
                    references, and subscription records. This can't be undone.
                </p>
                <div class="row-actions">
                    <button class="btn btn-danger" @onclick="StartDelete" disabled="@_busy">Delete @WorkspaceLabelLower</button>
                </div>
            }
            else
            {
                <div class="stack">
                    <p class="card-note">Deleting this @WorkspaceLabelLower will also remove:</p>
                    <ul class="blocker-list">
                        @if (report.OtherMemberCount > 0)
                        {
                            <li>@report.OtherMemberCount other member@(report.OtherMemberCount == 1 ? "" : "s") lose access.</li>
                        }
                        <li>Every invitation still pending.</li>
                    </ul>
                    <div class="field">
                        <label class="field-label" for="org-confirm">Type <strong>@WorkspaceEntity.Name</strong> to confirm</label>
                        <input id="org-confirm" class="form-input" @bind="_deleteConfirmation" @bind:event="oninput" autocomplete="off" disabled="@_busy" />
                    </div>
                    <div class="row-actions">
                        <button class="btn btn-danger" @onclick="ConfirmDelete" disabled="@(_busy || !DeleteConfirmed)">
                            @(_busy ? "Deleting…" : "Delete permanently")
                        </button>
                        <button class="btn btn-outline" @onclick="() => _confirmingDelete = false" disabled="@_busy">Cancel</button>
                    </div>
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="@(_success ? "alert-success" : "alert-error")" role="status">@_message</div>
    }
</div>

@code {
    [Parameter, EditorRequired] public required CloudWorkspaceDetailModel Workspace { get; set; }

    /// <summary>Display name for one workspace (e.g. "Organization", "Business"). Defaults to "Workspace".</summary>
    [Parameter] public string WorkspaceLabel { get; set; } = "Workspace";

    /// <summary>Display name for many workspaces (e.g. "Organizations", "Businesses"). Defaults to "Workspaces".</summary>
    [Parameter] public string WorkspaceLabelPlural { get; set; } = "Workspaces";

    private string WorkspaceLabelLower => WorkspaceLabel.ToLowerInvariant();

    /// <summary>
    /// Who owns this workspace, in one line. A workspace can have several owners, and the last
    /// one cannot be removed or demoted — saying so here is what makes that rule understandable
    /// when someone hits it, rather than an error appearing from nowhere.
    /// </summary>
    private string OwnershipSummary
    {
        get
        {
            int owners = Workspace.Members.Count(member =>
                member.IsOwner && member.State == CloudWorkspaceMembershipStates.Active);

            return owners switch
            {
                0 => $"This {WorkspaceLabelLower} has no active owner.",
                1 => $"One owner. A {WorkspaceLabelLower} always keeps at least one, so the last owner can't be removed.",
                _ => $"{owners} owners. A {WorkspaceLabelLower} always keeps at least one, so the last owner can't be removed."
            };
        }
    }

    /// <summary>Asks the parent to reload this workspace after a change lands.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    /// <summary>Raised once the workspace is gone, so the parent can leave its context.</summary>
    [Parameter] public EventCallback OnDeleted { get; set; }

    [Parameter] public EventCallback<string> OnNavigateToTab { get; set; }

    [CascadingParameter] private AccountErrorCenter? ErrorCenter { get; set; }

    private CloudWorkspaceModel WorkspaceEntity => Workspace.Workspace;

    private bool _busy;
    private string _message = string.Empty;
    private bool _success;

    private bool _editingProfile;
    private string _name = string.Empty;
    private string _legalName = string.Empty;
    private string _website = string.Empty;

    private bool _editingBilling;
    private string _additionalBillingInformation = string.Empty;
    private string _billingEmail = string.Empty;
    private string _billingPhone = string.Empty;
    private string _taxNumber = string.Empty;
    private string _line1 = string.Empty;
    private string _line2 = string.Empty;
    private string _city = string.Empty;
    private string _state = string.Empty;
    private string _postalCode = string.Empty;
    private string _country = string.Empty;

    private bool _inviting;
    private string _inviteRecipient = string.Empty;

    private bool _confirmingDelete;
    private string _deleteConfirmation = string.Empty;

    private bool DeleteConfirmed => string.Equals(_deleteConfirmation.Trim(), WorkspaceEntity.Name, StringComparison.OrdinalIgnoreCase);

    private void StartProfileEdit()
    {
        _editingProfile = true;
        _message = string.Empty;
        _name = WorkspaceEntity.Name;
        _legalName = WorkspaceEntity.LegalName ?? string.Empty;
        _website = WorkspaceEntity.Website ?? string.Empty;
    }

    private void StartBillingEdit()
    {
        _editingBilling = true;
        _message = string.Empty;
        _additionalBillingInformation = WorkspaceEntity.AdditionalBillingInformation ?? string.Empty;
        _billingEmail = WorkspaceEntity.BillingEmail ?? string.Empty;
        _billingPhone = WorkspaceEntity.BillingPhone ?? string.Empty;
        _taxNumber = WorkspaceEntity.TaxNumber ?? string.Empty;
        _line1 = WorkspaceEntity.BillingAddress.Line1 ?? string.Empty;
        _line2 = WorkspaceEntity.BillingAddress.Line2 ?? string.Empty;
        _city = WorkspaceEntity.BillingAddress.City ?? string.Empty;
        _state = WorkspaceEntity.BillingAddress.State ?? string.Empty;
        _postalCode = WorkspaceEntity.BillingAddress.PostalCode ?? string.Empty;
        _country = WorkspaceEntity.BillingAddress.Country ?? string.Empty;
    }

    private void StartInvite()
    {
        _inviting = true;
        _inviteRecipient = string.Empty;
        _message = string.Empty;
    }

    private void StartDelete()
    {
        _confirmingDelete = true;
        _deleteConfirmation = string.Empty;
        _message = string.Empty;
    }

    private async Task SaveProfile()
    {
        if (string.IsNullOrWhiteSpace(_name))
            return;

        await Submit($"{WorkspaceLabel} details saved.", async () =>
        {
            WorkspaceEntity.Name = _name.Trim();
            WorkspaceEntity.LegalName = _legalName;
            WorkspaceEntity.Website = _website;

            await cloudLogin.UpdateWorkspace(WorkspaceEntity.ToContract(OriginalContract()));
            _editingProfile = false;
        });
    }

    private async Task SaveBilling()
        => await Submit("Billing information saved.", async () =>
        {
            WorkspaceEntity.AdditionalBillingInformation = _additionalBillingInformation;
            WorkspaceEntity.BillingEmail = _billingEmail;
            WorkspaceEntity.BillingPhone = _billingPhone;
            WorkspaceEntity.TaxNumber = _taxNumber;
            WorkspaceEntity.BillingAddress = new CloudWorkspaceAddressModel
            {
                Line1 = _line1,
                Line2 = _line2,
                City = _city,
                State = _state,
                PostalCode = _postalCode,
                Country = _country
            };

            await cloudLogin.UpdateWorkspace(WorkspaceEntity.ToContract(OriginalContract()));
            _editingBilling = false;
        });

    private async Task SendInvite()
    {
        if (string.IsNullOrWhiteSpace(_inviteRecipient))
            return;

        string recipient = _inviteRecipient.Trim();

        await Submit($"Invitation sent to {recipient}.", async () =>
        {
            await cloudLogin.InviteToWorkspace(WorkspaceEntity.Id, recipient);
            _inviting = false;
        });
    }

    private async Task ConfirmDelete()
    {
        if (!DeleteConfirmed)
            return;

        try
        {
            _busy = true;
            _message = string.Empty;
            StateHasChanged();

            await cloudLogin.DeleteWorkspace(WorkspaceEntity.Id);
            await OnDeleted.InvokeAsync();
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            _success = false;
            _confirmingDelete = false;
            ErrorCenter?.Report($"{WorkspaceLabel} — deleting the {WorkspaceLabelLower}", exception.Message, exception);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Runs one write, then asks the parent to reload so every card reflects what the server
    /// actually stored rather than what was typed.
    /// </summary>
    private async Task Submit(string successMessage, Func<Task> operation)
    {
        if (_busy)
            return;

        try
        {
            _busy = true;
            _message = string.Empty;
            StateHasChanged();

            await operation();

            _message = successMessage;
            _success = true;

            await OnChanged.InvokeAsync();
        }
        catch (Exception exception)
        {
            _message = exception.Message;
            _success = false;
            ErrorCenter?.Report($"{WorkspaceLabel} — saving changes", exception.Message, exception);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// A stand-in for the workspace as the server last returned it, carrying only the
    /// system-owned fields (Id, OwnerUserId, CreatedOn) that <see cref="WorkspaceEntity"/>'s
    /// <c>ToContract</c> preserves rather than sending back from the edit buffer.
    /// </summary>
    private CloudWorkspace OriginalContract() => new()
    {
        Id = WorkspaceEntity.Id,
        Name = WorkspaceEntity.Name,
        OwnerUserId = WorkspaceEntity.OwnerUserId,
        CreatedOn = WorkspaceEntity.CreatedOn
    };

    private async Task Navigate(string tab) => await OnNavigateToTab.InvokeAsync(tab);

    private static string Or(string? value, string fallback = "Not specified")
        => string.IsNullOrWhiteSpace(value) ? fallback : value!;

    private static string? Muted(string? value) => string.IsNullOrWhiteSpace(value) ? "_muted" : null;
}
