@using AngryMonkey.CloudLogin.Interfaces
@using AngryMonkey.CloudComponents
@inject ICloudLogin cloudLogin
@inject NavigationManager navigationManager

@namespace AngryMonkey.CloudLogin

@* The account-switcher pattern: one compact trigger showing who/where you are now, opening a
   popover to jump to another context. Selecting a different one is a full account change —
   not a tab — so it hard-navigates rather than swapping state in place. Nothing here ever
   shows how many organizations exist or how many the account can still hold: the account only
   learns its allowance is exhausted when an attempt is actually refused. *@

<div class="workspace-switcher">
    <button type="button" class="workspace-trigger @(_open ? "_open" : "")" @onclick="ToggleMenu" aria-haspopup="true" aria-expanded="@(_open ? "true" : "false")">
        <span class="workspace-trigger-mark @(CurrentOrganizationId is null ? "_personal" : "")" aria-hidden="true">
            @if (CurrentOrganizationId is null)
            {
                <PersonIcon />
            }
            else
            {
                @AccountDisplayHelpers.Initials(CurrentOrganizationName)
            }
        </span>
        <span class="workspace-trigger-copy tab-label">
            <span class="workspace-trigger-eyebrow">Workspace</span>
            <span class="workspace-trigger-name">@(CurrentOrganizationId is null ? "Personal account" : CurrentOrganizationName)</span>
        </span>
        <span class="workspace-trigger-chevron tab-label" aria-hidden="true"><ChevronIcon /></span>
    </button>

    @if (_open)
    {
        <div class="workspace-menu-backdrop" @onclick="CloseMenu"></div>

        <div class="workspace-menu" role="menu" @onkeydown="OnMenuKeyDown">
            @if (_creating)
            {
                <div class="workspace-menu-create">
                    <div class="workspace-menu-create-header">
                        <button type="button" class="workspace-menu-back" @onclick="CancelCreate" aria-label="Back to workspaces">
                            <span class="workspace-menu-back-icon" aria-hidden="true"><ChevronIcon /></span>
                        </button>
                        <span>New organization</span>
                    </div>
                    <input class="workspace-menu-input" placeholder="Organization name" @bind="_newName" @bind:event="oninput"
                           @onkeydown="OnCreateKeyDown" disabled="@_busy" autofocus />
                    <button type="button" class="workspace-menu-create-submit" @onclick="CreateAsync" disabled="@(_busy || string.IsNullOrWhiteSpace(_newName))">
                        @(_busy ? "Creating…" : "Create organization")
                    </button>
                </div>
            }
            else
            {
                <div class="workspace-menu-header">Switch workspace</div>

                <div class="workspace-menu-list">
                    <button type="button" class="workspace-menu-item @(CurrentOrganizationId is null ? "_active" : "")" role="menuitemradio" aria-checked="@(CurrentOrganizationId is null ? "true" : "false")" @onclick="() => Select(null)">
                        <span class="workspace-menu-item-mark _personal" aria-hidden="true"><PersonIcon /></span>
                        <span class="workspace-menu-item-copy">
                            <span class="workspace-menu-item-name">Personal account</span>
                            @if (!string.IsNullOrWhiteSpace(AccountLabel))
                            {
                                <span class="workspace-menu-item-meta">@AccountLabel</span>
                            }
                        </span>
                        @if (CurrentOrganizationId is null)
                        {
                            <span class="workspace-menu-item-check" aria-hidden="true"><Checkmark /></span>
                        }
                    </button>

                    @if (Organizations.Count > 0)
                    {
                        <div class="workspace-menu-divider" role="separator"></div>

                        @foreach (CloudLoginOrganization organization in Organizations)
                        {
                            <button type="button" class="workspace-menu-item @(CurrentOrganizationId == organization.Id ? "_active" : "")" role="menuitemradio" aria-checked="@(CurrentOrganizationId == organization.Id ? "true" : "false")" @onclick="() => Select(organization.Id)">
                                <span class="workspace-menu-item-mark" aria-hidden="true">@AccountDisplayHelpers.Initials(organization.Name)</span>
                                <span class="workspace-menu-item-copy">
                                    <span class="workspace-menu-item-name">@organization.Name</span>
                                    <span class="workspace-menu-item-meta">@(organization.OwnerUserId == CurrentUserId ? "Owner" : "Member")</span>
                                </span>
                                @if (CurrentOrganizationId == organization.Id)
                                {
                                    <span class="workspace-menu-item-check" aria-hidden="true"><Checkmark /></span>
                                }
                            </button>
                        }
                    }
                </div>

                <div class="workspace-menu-divider" role="separator"></div>

                <button type="button" class="workspace-menu-add" @onclick="StartCreate">
                    <span class="workspace-menu-add-icon" aria-hidden="true"><AddIcon /></span>
                    Create organization
                </button>
            }
        </div>
    }
</div>

<Dialog @ref="_limitDialog" Title="Can't create organization" Buttons="_limitDialogButtons">
    <p>@_limitMessage</p>
</Dialog>

@code {
    /// <summary>Null when the personal account is the active context.</summary>
    [Parameter] public Guid? CurrentOrganizationId { get; set; }

    [Parameter] public List<CloudLoginOrganization> Organizations { get; set; } = [];

    [Parameter] public Guid? CurrentUserId { get; set; }

    /// <summary>Shown under "Personal account" in the menu — typically the signed-in user's name or email.</summary>
    [Parameter] public string? AccountLabel { get; set; }

    /// <summary>The base path the account page is mounted at, e.g. "/Account". Every switch navigates relative to this.</summary>
    [Parameter] public string BasePath { get; set; } = "/Account";

    /// <summary>Raised after a new organization is created, so the caller's cached list can catch up (a hard navigation follows regardless).</summary>
    [Parameter] public EventCallback OnOrganizationCreated { get; set; }

    private string CurrentOrganizationName
        => Organizations.FirstOrDefault(organization => organization.Id == CurrentOrganizationId)?.Name ?? "Organization";

    private string Base => "/" + BasePath.Trim('/');

    private bool _open;
    private bool _creating;
    private bool _busy;
    private string _newName = string.Empty;

    private Dialog? _limitDialog;
    private string _limitMessage = string.Empty;
    private readonly List<DialogButton> _limitDialogButtons =
    [
        new DialogButton { Text = "Got it", ClassCss = "workspace-menu-create-submit", AutoClose = true }
    ];

    private void ToggleMenu()
    {
        _open = !_open;
        _creating = false;
    }

    private void CloseMenu()
    {
        _open = false;
        _creating = false;
    }

    private void OnMenuKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
            CloseMenu();
    }

    /// <summary>
    /// Moving to a different workspace is treated like switching accounts, not like changing
    /// tabs: a full reload so every cached list, form, and open state starts clean rather than
    /// carrying over from whichever context was open a moment ago.
    /// </summary>
    private void Select(Guid? organizationId)
    {
        _open = false;

        if (organizationId == CurrentOrganizationId)
            return;

        string url = organizationId is Guid id ? $"{Base}/Org/{id}" : Base;
        navigationManager.NavigateTo(url, forceLoad: true);
    }

    private void StartCreate()
    {
        _creating = true;
        _newName = string.Empty;
    }

    private void CancelCreate()
    {
        _creating = false;
        _newName = string.Empty;
    }

    private async Task OnCreateKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter")
            await CreateAsync();
    }

    private async Task CreateAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_newName))
            return;

        try
        {
            _busy = true;
            StateHasChanged();

            CloudLoginOrganization created = await cloudLogin.CreateOrganization(_newName.Trim());
            await OnOrganizationCreated.InvokeAsync();

            // Landing directly inside the new organization mirrors just having created it —
            // the natural next step, not an extra click back through the switcher.
            navigationManager.NavigateTo($"{Base}/Org/{created.Id}", forceLoad: true);
        }
        catch (Exception exception)
        {
            _open = false;
            _creating = false;
            _limitMessage = exception.Message;

            if (_limitDialog is not null)
                await _limitDialog.Open();
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }
}
