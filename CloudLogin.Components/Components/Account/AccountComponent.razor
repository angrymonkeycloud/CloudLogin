@using AngryMonkey.CloudLogin.Interfaces

@rendermode @(new InteractiveWebAssemblyRenderMode(false))

@inject ICloudLogin cloudLogin
@inject NavigationManager navigationManager

@namespace AngryMonkey.CloudLogin

@if (RendererInfo.IsInteractive)
{
    @if (CurrentUser != null)
    {
        <div class="account-management @(activeTab == "Admin" ? "_admin" : "")">
            <div class="account-shell">
                <nav class="sidebar @(navOpen ? "_open" : "")" aria-label="Account navigation">
                    <button type="button" class="sidebar-toggle" @onclick="ToggleNav" aria-expanded="@(navOpen ? "true" : "false")" aria-label="@(navOpen ? "Collapse navigation" : "Expand navigation")">
                        <span class="sidebar-toggle-icon" aria-hidden="true">
                            @if (navOpen)
                            {
                                <Close />
                            }
                            else
                            {
                                <MenuIcon />
                            }
                        </span>
                    </button>

                    <div class="profile-mini">
                        @if (!string.IsNullOrWhiteSpace(CurrentUser.ProfilePicture))
                        {
                            <img class="profile-mini-avatar" src="@CurrentUser.ProfilePicture" alt="Profile picture" />
                        }
                        else
                        {
                            <div class="profile-mini-avatar initials" aria-hidden="true">@GetInitials()</div>
                        }
                        <div class="profile-mini-copy">
                            <div class="profile-mini-name">@GetDisplayName()</div>
                            <div class="profile-mini-email">@GetPrimaryEmail()</div>
                        </div>
                    </div>

                    <div class="tabs">
                        @foreach (var tab in Tabs)
                        {
                            <button class="tab-button @(activeTab == tab.Name ? "active" : "")" @onclick="() => SwitchTab(tab.Name)" title="@tab.DisplayName">
                                <span class="tab-icon" aria-hidden="true">@TabIcon(tab.Name)</span>
                                <span class="tab-label">@tab.DisplayName</span>
                            </button>
                        }
                        @if (CurrentUser.IsGlobalAdmin)
                        {
                            <button class="tab-button tab-button--admin @(activeTab == "Admin" ? "active" : "")" @onclick='() => SwitchTab("Admin")' title="Admin">
                                <span class="tab-icon" aria-hidden="true"><ShieldCheckIcon /></span>
                                <span class="tab-label">Admin<span class="admin-tab-badge">&#9733;</span></span>
                            </button>
                        }
                    </div>

                    @if (string.IsNullOrEmpty(Referer))
                    {
                        <div class="sidebar-footer">
                            <button class="tab-button tab-button--logout" @onclick="SignOut" title="Log out">
                                <span class="tab-icon" aria-hidden="true"><SignOutIcon /></span>
                                <span class="tab-label">Log out</span>
                            </button>
                        </div>
                    }
                </nav>

                @if (navOpen)
                {
                    <div class="nav-backdrop" @onclick="CollapseNav"></div>
                }

                <div class="tab-content">
                    <header class="account-page-header">
                        <div>
                            <span class="account-page-eyebrow">CloudLogin account</span>
                            <h1>@GetActiveTabDisplayName()</h1>
                        </div>
                        <div class="account-security-pill" title="Your CloudLogin session is protected">
                            <span aria-hidden="true">&#10003;</span>
                            Secure session
                        </div>
                    </header>
                    @if (activeTab == "Profile")
                    {
                        <AccountComponent_Profile CurrentUser="CurrentUser" />
                    }
                    else if (activeTab == "Subscriptions")
                    {
                        <AccountComponent_Subscriptions TargetSubscriptionId="@TargetEntityId" />
                    }
                    else if (activeTab == "Organizations")
                    {
                        <AccountComponent_Organizations TargetOrganizationId="@TargetEntityId" />
                    }
                    else if (activeTab == "PaymentMethods")
                    {
                        <AccountComponent_PaymentMethods />
                    }
                    else if (activeTab == "Admin" && CurrentUser.IsGlobalAdmin)
                    {
                        <AdminComponent AdminUserId="@AdminUserId" />
                    }
                    else
                    {
                        <AccountComponent_Overview CurrentUser="CurrentUser"
                                                    EnableSubscriptions="EnableSubscriptions"
                                                    EnableOrganizations="EnableOrganizations"
                                                    EnablePayments="EnablePayments"
                                                    OnNavigateToTab="SwitchTab"
                                                    OnDeleteAccount="DeleteAccount" />
                    }
                </div>
            </div>
        </div>
    }

}
else
{
    <section class="account-management skelton">
        <article>
            <div class="tabs">
                <div class="tab">
                </div>
                <div class="tab">
                </div>
                <div class="tab">
                </div>
                <div class="tab">
                </div>
            </div>
            <div class="body">
            </div>
        </article>

    </section>
}


@code {
    [Parameter] public string? Referer { get; set; }

    /// <summary>When set (and the signed-in user is a global admin), opens straight to this user in the Admin tab.</summary>
    [Parameter] public Guid? AdminUserId { get; set; }

    /// <summary>Initial account section selected by a trusted deep link.</summary>
    [Parameter] public string? InitialSection { get; set; }

    /// <summary>Specific organization or subscription addressed by the deep link.</summary>
    [Parameter] public Guid? TargetEntityId { get; set; }

    [Parameter] public bool EnableSubscriptions { get; set; }
    [Parameter] public bool EnableOrganizations { get; set; }
    [Parameter] public bool EnablePayments { get; set; }

    private UserModel? CurrentUser { get; set; }
    private bool navOpen = false;

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await cloudLogin.CurrentUser();

        if (AdminUserId.HasValue && CurrentUser is { IsGlobalAdmin: true })
            activeTab = "Admin";
        if (!string.IsNullOrWhiteSpace(InitialSection) && Tabs.Any(tab => tab.Name == InitialSection))
            activeTab = InitialSection;

    }

    private string activeTab = "Overview";

    private IEnumerable<TabItem> Tabs
    {
        get
        {
            yield return new() { Name = "Overview", DisplayName = "Overview" };
            yield return new() { Name = "Profile", DisplayName = "Profile" };

            if (EnableSubscriptions)
                yield return new() { Name = "Subscriptions", DisplayName = "Subscriptions" };

            if (EnableOrganizations)
                yield return new() { Name = "Organizations", DisplayName = "Organizations" };

            if (EnablePayments)
                yield return new() { Name = "PaymentMethods", DisplayName = "Payment options" };
        }
    }

    private class TabItem
    {
        public required string Name { get; set; }
        public required string DisplayName { get; set; }
    }

    private void SwitchTab(string tab)
    {
        activeTab = tab;
        navOpen = false;
    }

    private void ToggleNav() => navOpen = !navOpen;
    private void CollapseNav() => navOpen = false;

    private static RenderFragment TabIcon(string tabName) => tabName switch
    {
        "Overview" => @<GridIcon />,
        "Profile" => @<PersonIcon />,
        "Subscriptions" => @<CreditCardIcon />,
        "Organizations" => @<BuildingIcon />,
        "PaymentMethods" => @<WalletIcon />,
        "Admin" => @<ShieldCheckIcon />,
        _ => @<GridIcon />
    };

    private string GetActiveTabDisplayName()
        => activeTab == "Admin"
            ? "Administration"
            : Tabs.FirstOrDefault(tab => tab.Name == activeTab)?.DisplayName ?? "Account";

    private string GetDisplayName()
    {
        string? full = CurrentUser?.DisplayName;
        if (string.IsNullOrWhiteSpace(full))
            full = string.Join(" ", new[] { CurrentUser?.FirstName, CurrentUser?.LastName }.Where(s => !string.IsNullOrWhiteSpace(s)));
        return string.IsNullOrWhiteSpace(full) ? "Account" : full!;
    }

    private string GetPrimaryEmail()
        => (CurrentUser?.PrimaryEmailAddress ?? CurrentUser?.EmailAddresses.FirstOrDefault())?.Input ?? string.Empty;

    private string GetInitials()
    {
        var parts = new[] { CurrentUser?.FirstName, CurrentUser?.LastName }
            .Where(s => !string.IsNullOrWhiteSpace(s))
            .Select(s => s!.Trim());
        var initials = string.Concat(parts.Select(p => char.ToUpperInvariant(p[0])));
        if (string.IsNullOrWhiteSpace(initials) && !string.IsNullOrWhiteSpace(CurrentUser?.DisplayName))
            initials = new string(CurrentUser!.DisplayName!.Where(char.IsLetter).Take(2).Select(char.ToUpperInvariant).ToArray());
        return string.IsNullOrWhiteSpace(initials) ? "?" : initials;
    }

    private void SignOut()
    {
        navigationManager.NavigateTo("/CloudLogin/Logout", true);
    }

    private async Task DeleteAccount()
    {
        if (CurrentUser == null)
            return;

        await cloudLogin.DeleteUser(CurrentUser.ID);

        navigationManager.NavigateTo("/CloudLogin/Logout", true);
    }
}
