@rendermode @(new InteractiveWebAssemblyRenderMode(true))

@namespace AngryMonkey.CloudLogin

@if (!RendererInfo.IsInteractive)
{

    <div class="pageloading">
        <div class="pageloading-logo">
            <img src="/logo.svg?v=1" />
        </div>
        <div class="pageloading-progress">
            <span></span>
        </div>
    </div>
}
else
{
    <AngryMonkey.CloudLogin.AccountComponent Referer="@Referer" AdminUserId="@AdminUserId" InitialSection="@InitialSection" TargetEntityId="@TargetEntityId" />
}

@code {
    [Parameter] public string? Referer { get; set; }
    [Parameter] public Guid? AdminUserId { get; set; }
    [Parameter] public string? InitialSection { get; set; }
    [Parameter] public Guid? TargetEntityId { get; set; }
}