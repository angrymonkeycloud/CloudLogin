@rendermode @(new InteractiveWebAssemblyRenderMode(true))

@namespace AngryMonkey.CloudLogin

@if (!RendererInfo.IsInteractive)
{

    <div class="pageloading">
        <div class="pageloading-logo">
            <img src="/logo.svg?v=1" />
        </div>
        <div class="pageloading-progress">
            <span></span>
        </div>
    </div>
}
else
{
    <AngryMonkey.CloudLogin.AccountComponent Referer="@Referer"
                                               AdminUserId="@AdminUserId"
                                               InitialSection="@InitialSection"
                                               TargetEntityId="@TargetEntityId"
                                               EnableWorkspaces="@EnableWorkspaces"
                                               WorkspaceLabel="@WorkspaceLabel"
                                               WorkspaceLabelPlural="@WorkspaceLabelPlural"
                                               BasePath="@BasePath" />
}

@code {
    [Parameter] public string? Referer { get; set; }
    [Parameter] public Guid? AdminUserId { get; set; }
    [Parameter] public string? InitialSection { get; set; }
    [Parameter] public Guid? TargetEntityId { get; set; }
    [Parameter] public bool EnableWorkspaces { get; set; }

    /// <summary>Display name for one workspace (e.g. "Organization", "Business"). Defaults to "Workspace".</summary>
    [Parameter] public string WorkspaceLabel { get; set; } = "Workspace";

    /// <summary>Display name for many workspaces (e.g. "Organizations", "Businesses"). Defaults to "Workspaces".</summary>
    [Parameter] public string WorkspaceLabelPlural { get; set; } = "Workspaces";

    /// <summary>The path the host mounted this page at, e.g. "/Account". Used to build and parse every tab and workspace URL.</summary>
    [Parameter] public string BasePath { get; set; } = "/Account";
}
