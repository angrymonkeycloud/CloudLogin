@namespace AngryMonkey.CloudLogin

@if (OperatingSystem is "macOS" or "iPhone" or "iPad" or "iOS")
{
    <AppleLogo />
}
else
{
    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true" focusable="false">
        @switch (OperatingSystem)
        {
            case "Windows":
                <path d="M2 3.5 11 2.3v9H2zm10-1.3L22 1v10.3H12zM2 12.3h9v9L2 20zm10 0h10V23l-10-1.4z" />
                break;
            case "Android":
                <path d="m6.2 4.5-1.4-2 .8-.5 1.5 2.1a10 10 0 0 1 9.8 0L18.4 2l.8.5-1.4 2A7 7 0 0 1 21 10H3a7 7 0 0 1 3.2-5.5M7 7h2V6H7zm8 0h2V6h-2zM3 11h18v7a2 2 0 0 1-2 2h-1v3h-3v-3H9v3H6v-3H5a2 2 0 0 1-2-2z" />
                break;
            case "Linux":
                <ellipse cx="12" cy="12" rx="7" ry="10" /><ellipse cx="12" cy="15" rx="4" ry="5" fill="white" />
                <circle cx="10" cy="6" r="1" fill="white" /><circle cx="14" cy="6" r="1" fill="white" />
                <path d="m9 8 3 3 3-3zM3 21l6-2v4H3zm12-2 6 2v2h-6z" fill="#eab308" />
                break;
            default:
                <path d="M3 3h18a2 2 0 0 1 2 2v12H1V5a2 2 0 0 1 2-2m0 2v10h18V5zM8 19h8v2h4v2H4v-2h4z" />
                break;
        }
    </svg>
}

@code {
    [Parameter] public string? OperatingSystem { get; set; }
}