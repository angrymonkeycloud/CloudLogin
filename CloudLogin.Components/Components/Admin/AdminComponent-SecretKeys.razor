@using AngryMonkey.CloudLogin.V3
@inherits AdminPanelBase
@namespace AngryMonkey.CloudLogin

<AdminComponent_Feedback Busy="Busy" Error="@Error" Notice="@Notice" />

<p class="console-muted">A website with a backend signs in with its own name and any active key below. Several websites can share a key. Revoking a key stops every website using it at once.</p>

@if (_issued is not null)
{
    <div class="console-secret" role="alert">
        <strong>Copy the secret of "@_issued.Key.Label" now.</strong>
        <p>It is shown only once. CloudLogin keeps a hash, not the value, so it cannot be shown again; if it is lost, create another key. Give it to a website as <span class="console-mono">CloudLogin:ClientSecret</span>.</p>
        <input class="console-input console-mono" readonly value="@_issued.KeyValue" onclick="this.select()" />
        <button class="console-btn" @onclick="() => _issued = null">I have stored it</button>
    </div>
}

@if (Can("secretkeys.manage"))
{
    <div class="console-toolbar">
        <button class="console-btn console-btn--primary" @onclick="() => _creating = !_creating">@(_creating ? "Cancel" : "Create a secret key")</button>
    </div>

    @if (_creating)
    {
        <form class="console-panel console-form" @onsubmit="CreateAsync" @onsubmit:preventDefault>
            <label>Label <span class="console-muted">(what it is for, for example "Partner websites")</span><input class="console-input" @bind="_label" maxlength="60" /></label>
            <label>Expires <span class="console-muted">(leave empty for a key that does not expire)</span><input class="console-input" type="date" @bind="_expiresOn" /></label>
            <button class="console-btn console-btn--primary" type="submit" disabled="@Busy">Create</button>
        </form>
    }
}

<div class="console-table-wrap">
    <table class="console-table">
        <thead><tr><th>Key</th><th>Status</th><th>Created</th><th>Expires</th><th>Last used</th><th></th></tr></thead>
        <tbody>
            @foreach (V3AdminSecretKeyModel key in _keys)
            {
                <tr>
                    <td>
                        @key.Label
                        <span class="console-muted console-mono">@(key.Prefix is null ? key.Id : $"{key.Prefix}...")</span>
                    </td>
                    <td><span class="console-pill console-pill--@StatusClass(key.Status)">@key.Status</span></td>
                    <td>@(key.IsDeployment ? "By the deployment" : When(key.CreatedOn))</td>
                    <td>@(key.ExpiresOn is null ? "Never" : When(key.ExpiresOn))</td>
                    <td>@Ago(key.LastUsedOn)@(key.LastUsedBy is null ? "" : $" by {key.LastUsedBy}")</td>
                    <td>
                        @if (key.Status != "Revoked" && Can("secretkeys.revoke"))
                        {
                            @if (_confirmRevoke == key.Id)
                            {
                                <button class="console-btn console-btn--danger" disabled="@Busy" @onclick="() => RevokeAsync(key)">Confirm revoke</button>
                                <button class="console-btn" @onclick="() => _confirmRevoke = null">Keep</button>
                            }
                            else
                            {
                                <button class="console-btn" @onclick="() => _confirmRevoke = key.Id">Revoke</button>
                            }
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (_keys.Count == 0 && !Busy)
{
    <p class="console-empty">No secret keys yet. Create one, or reference CloudLogin from an AppHost, which declares one for its websites.</p>
}

@code {
    private List<V3AdminSecretKeyModel> _keys = [];
    private V3AdminIssuedSecretKeyResponse? _issued;
    private bool _creating;
    private string? _label;
    private DateTime? _expiresOn;
    private string? _confirmRevoke;

    protected override Task OnInitializedAsync() => RunAsync(async () =>
    {
        if (Api is { } api)
            _keys = await api.GetSecretKeysAsync();
    });

    private Task CreateAsync() => RunAsync(async () =>
    {
        DateTimeOffset? expires = _expiresOn is { } date ? new DateTimeOffset(date.Date, TimeSpan.Zero).AddDays(1) : null;

        _issued = await Api!.CreateSecretKeyAsync(_label, expires);
        _creating = false;
        _label = null;
        _expiresOn = null;
        _keys = await Api.GetSecretKeysAsync();
    });

    private Task RevokeAsync(V3AdminSecretKeyModel key) => RunAsync(async () =>
    {
        await Api!.RevokeSecretKeyAsync(key.Id, null);
        _confirmRevoke = null;
        _keys = await Api.GetSecretKeysAsync();
    }, $"\"{key.Label}\" revoked. Websites using it can no longer sign in.");
}
