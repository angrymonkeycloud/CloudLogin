@using AngryMonkey.CloudLogin.Interfaces
@using AngryMonkey.CloudLogin.V3
@inject ICloudLogin cloudLogin

@namespace AngryMonkey.CloudLogin

<div class="admin-panel admin-console">
    <div class="admin-header">
        <p class="admin-subtitle">Users, the applications using CloudLogin, secret keys, sessions and the security of the whole authentication ecosystem.</p>
        @if (_me is not null)
        {
            <span class="admin-badge">@(_me.IsGlobalAdmin ? "Global Admin" : "Administrator")</span>
        }
    </div>

    @if (_loading)
    {
        <p class="console-empty">Loading...</p>
    }
    else if (_failure is not null)
    {
        <p class="console-feedback console-feedback--error" role="alert">@_failure</p>
    }
    else if (_me is not null)
    {
        <nav class="admin-tabs" aria-label="Administration sections">
            @foreach (IGrouping<string, AdminTab> group in Tabs.Where(tab => _me.Permissions.Contains(tab.Permission)).GroupBy(tab => tab.Group))
            {
                <div class="admin-tabs-group" role="group" aria-label="@group.Key">
                    <div class="admin-tabs-group-label" aria-hidden="true">@group.Key</div>
                    <div class="admin-tabs-group-items">
                        @foreach (AdminTab tab in group)
                        {
                            <button type="button" class="admin-tab @(_active == tab.Key ? "active" : "")" aria-current="@(_active == tab.Key ? "page" : null)" @onclick="() => _active = tab.Key"><span class="admin-tab-icon" aria-hidden="true">@TabIcon(tab.Key)</span><span class="admin-tab-label">@tab.Label</span></button>
                        }
                    </div>
                </div>
            }
        </nav>

        <div class="admin-content">
            @switch (_active)
            {
                case "overview":
                    <AdminComponent_Overview Access="_me" />
                    break;
                case "users":
                    <AdminComponent_Users Access="_me" UserId="AdminUserId" />
                    break;
                case "applications":
                    <AdminComponent_Applications Access="_me" />
                    break;
                case "secretkeys":
                    <AdminComponent_SecretKeys Access="_me" />
                    break;
                case "sessions":
                    <AdminComponent_Sessions Access="_me" />
                    break;
                case "security":
                    <AdminComponent_Security Access="_me" />
                    break;
                case "providers":
                    <AdminComponent_Providers Access="_me" />
                    break;
                case "audit":
                    <AdminComponent_Audit Access="_me" />
                    break;
                case "administrators":
                    <AdminComponent_Administrators Access="_me" OnOwnAccessChanged="LoadAccessAsync" />
                    break;
            }
        </div>
    }
</div>

@code {
    /// <summary>When set, opens this user's detail straight away instead of the overview.</summary>
    [Parameter] public Guid? AdminUserId { get; set; }

    private sealed record AdminTab(string Key, string Label, string Permission, string Group);

    private static readonly AdminTab[] Tabs =
    [
        new("overview", "Overview", "dashboard.read", "Dashboard"),
        new("users", "Users", "users.read", "People"),
        new("administrators", "Administrators", "administrators.read", "People"),
        new("applications", "Applications", "applications.read", "Applications"),
        new("secretkeys", "Secret keys", "applications.read", "Applications"),
        new("sessions", "Sessions", "sessions.read", "Applications"),
        new("security", "Security", "keys.read", "Security"),
        new("providers", "Providers", "providers.read", "Security"),
        new("audit", "Audit", "audit.read", "Security")
    ];

    private V3AdminMeResponse? _me;
    private string? _failure;
    private bool _loading = true;
    private string _active = "overview";

    private static RenderFragment TabIcon(string key) => key switch
    {
        "overview" => @<HomeIcon />,
        "users" => @<UsersIcon />,
        "administrators" => @<ShieldCheckIcon />,
        "applications" => @<GridIcon />,
        "secretkeys" => @<KeyIcon />,
        "sessions" => @<LaptopIcon />,
        "security" => @<ShieldIcon />,
        "providers" => @<LinkIcon />,
        "audit" => @<ClipboardIcon />,
        _ => @<HomeIcon />
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAccessAsync();

        if (_me is not null && AdminUserId.HasValue && _me.Permissions.Contains("users.read"))
            _active = "users";
    }

    private async Task LoadAccessAsync()
    {
        try
        {
            if (cloudLogin is not CloudLoginClient client)
            {
                _failure = "The administration console runs in the browser client.";
                return;
            }

            _me = await client.Admin.GetMeAsync();

            if (Tabs.FirstOrDefault(tab => tab.Key == _active) is not { } current || !_me.Permissions.Contains(current.Permission))
                _active = Tabs.FirstOrDefault(tab => _me.Permissions.Contains(tab.Permission))?.Key ?? "overview";
        }
        catch (CloudLoginAdminException exception)
        {
            _me = null;
            _failure = exception.IsForbidden ? "This account is not a CloudLogin administrator." : exception.Message;
        }
        catch (HttpRequestException)
        {
            _failure = "The authority could not be reached.";
        }
        finally
        {
            _loading = false;
        }
    }
}
