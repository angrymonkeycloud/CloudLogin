@switch (Provider.Code)
{
    case "Microsoft":
        <MicrosoftLogo UseDefaultTheme="UseDefaultColor" />
        break;

    case "Google":
        <GoogleLogo UseDefaultTheme="UseDefaultColor" />
        break;

    case "Facebook":
        <FacebookLogo UseDefaultTheme="UseDefaultColor" />
        break;

    case "Apple":
        <AppleLogo UseDefaultTheme="UseDefaultColor" />
        break;

    case "Twitter":
        <TwitterLogo UseDefaultTheme="UseDefaultColor" />
        break;

    default: break;
}