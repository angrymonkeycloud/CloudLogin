<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
		<PackageReference Include="Aspire.Hosting" Version="13.5.3" />
		<PackageReference Include="Aspire.Hosting.Azure.CosmosDB" Version="13.5.3" />
		<PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.5.3" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CloudLogin.Client\CloudLogin.Client.csproj" />
		<ProjectReference Include="..\CloudLogin.Contracts\CloudLogin.Contracts.csproj" />
		<ProjectReference Include="..\CloudLogin.Server\CloudLogin.Server.csproj" />
		<ProjectReference Include="..\CloudLogin.API\CloudLogin.API.csproj" />
		<ProjectReference Include="..\CloudLogin.Aspire\CloudLogin.Aspire.csproj" />
		<ProjectReference Include="..\CloudLogin.Aspire.Hosting\CloudLogin.Aspire.Hosting.csproj" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="artifacts\**" />
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
