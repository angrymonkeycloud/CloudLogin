<Project Sdk="Microsoft.NET.Sdk.Razor">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AssemblyName>AngryMonkey.CloudLogin.Web</AssemblyName>
		<RootNamespace>AngryMonkey.CloudLogin</RootNamespace>
		<UserSecretsId>16b89c4e-cbd8-4756-8ed2-cb7b829d7de2</UserSecretsId>
		<Product>Cloud Login Web</Product>
		<Authors>Angry Monkey</Authors>
		<Description>Add this library to the main stand alone Login website.</Description>
		<Company>Angry Monkey</Company>
		<AssemblyVersion>$(PackageVersion)</AssemblyVersion>
		<FileVersion>$(PackageVersion)</FileVersion>
		<Version>1.5.3</Version>
		<PackageOutputPath>../../../../../NugetPackages</PackageOutputPath>
		<PackageIcon>amc-logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Configurations>Debug;Release</Configurations>
		<StaticWebAssetsCacheDefineStaticWebAssetsEnabled>false</StaticWebAssetsCacheDefineStaticWebAssetsEnabled>
	</PropertyGroup>

	<ItemGroup>
	  <None Include="compilerconfig.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="AngryMonkey.CloudBlazor.Web" Version="1.0.1" />
		<PackageReference Include="Azure.Identity" Version="1.21.0" />
		<PackageReference Include="Azure.Security.KeyVault.Certificates" Version="4.9.0" />
		<PackageReference Include="Azure.Security.KeyVault.Secrets" Version="4.11.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Certificate" Version="10.0.10" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
		<PackageReference Include="Microsoft.Azure.Cosmos" Version="3.62.0" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.10" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.10" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.MicrosoftAccount" Version="10.0.10" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" NoWarn="NU1605" />
		<PackageReference Include="Microsoft.AspNetCore.Authentication.Twitter" Version="10.0.10" />
		<PackageReference Include="AngryMonkey.CloudGeography" Version="2.8.0" />
		<PackageReference Include="Microsoft.Graph" Version="6.2.0" />
		<PackageReference Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.1" />
		<PackageReference Include="Microsoft.Kiota.Abstractions" Version="2.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CloudLogin.API\CloudLogin.API.csproj" />
		<ProjectReference Include="..\CloudLogin.WebAssembly\CloudLogin.WebAssembly.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Update="amc-logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md" Pack="True" PackagePath="\" Link="README.md" />
	</ItemGroup>

</Project>
