@using AngryMonkey.CloudBlazor.Web
@using AngryMonkey.CloudLogin.Server
@inject CloudLoginWebConfiguration Config

<!DOCTYPE html>
<html lang="en">

<head>
    <base href="/" />
    <CloudHeadPlaceholder />
    <style>
        :root {
            --cloudlogin-color: @Config.PrimaryColor;
            --amc-accentColor: var(--cloudlogin-color, #0078D4);
            --amc-secondColor: color-mix(in srgb, var(--amc-accentColor) 82%, #000);
            --amc-accentColor-soft: color-mix(in srgb, var(--amc-accentColor) 10%, #fff);
        }
    </style>
</head>

<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
