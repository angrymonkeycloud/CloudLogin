@using AngryMonkey.CloudCommon.Theming
@using AngryMonkey.CloudCommon.Theming.Blazor
@using AngryMonkey.CloudBlazor.Web
@using AngryMonkey.CloudLogin.Server
@inject CloudLoginWebConfiguration Config

<!DOCTYPE html>
<html lang="en" data-amc-theme="@Config.ThemeMode.ToString().ToLowerInvariant()">

<head>
    <base href="/" />
    <CloudHeadPlaceholder />
    <CloudThemeDocument Theme="@(Config.ResolveTheme())" />
</head>

<body>
    <Routes />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
