@page "/Account"
@using AngryMonkey.CloudBlazor.Web
@using AngryMonkey.CloudLogin.Server
@inject CloudLoginWebConfiguration Configuration


<CloudHeadContent />

<AngryMonkey.CloudLogin.AccountPageComponent Referer="@Referer"
                                                    AdminUserId="@AdminUserId"
                                                    InitialSection="@Section"
                                                    TargetEntityId="@EntityId"
                                                    EnableSubscriptions="@(Configuration.Subscription is not null)"
                                                    EnableOrganizations="@(Configuration.Organization is not null)"
                                                    EnablePayments="@(Configuration.Payment is not null)" />

@code{
    [SupplyParameterFromQuery]
    public string? Referer { get; set; }

    /// <summary>Deep-links a global admin straight to this user's detail view in the Admin tab.</summary>
    [SupplyParameterFromQuery]
    public Guid? AdminUserId { get; set; }

    [SupplyParameterFromQuery]
    public string? Section { get; set; }

    [SupplyParameterFromQuery]
    public Guid? EntityId { get; set; }


}
