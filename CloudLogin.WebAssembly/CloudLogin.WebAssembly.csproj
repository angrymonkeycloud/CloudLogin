<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<IsPackable>true</IsPackable>
		<AddRazorSupportForMvc>true</AddRazorSupportForMvc>
		<AssemblyName>AngryMonkey.CloudLogin.WebAssembly</AssemblyName>
		<RootNamespace>AngryMonkey.CloudLogin.WebAssembly</RootNamespace>
		<AssemblyVersion>$(PackageVersion)</AssemblyVersion>
		<FileVersion>$(PackageVersion)</FileVersion>
		<Version>2.0.2</Version>
		<Authors>Angry Monkey</Authors>
		<Company>Angry Monkey</Company>
		<PackageIcon>amc-logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Product>Cloud Login WebAssembly</Product>
		<Configurations>Debug;Release</Configurations>
		<Description>The Blazor WebAssembly runtime CloudLogin's standalone UI package runs its interactive components under - referenced automatically by CloudLogin.Web, not added directly by consuming apps.</Description>
		<PackageTags>cloudlogin;authentication;blazor;webassembly;angrymonkey</PackageTags>
		<PackageOutputPath>../../../../../NugetPackages</PackageOutputPath>
	</PropertyGroup>


	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
	</ItemGroup>


	<ItemGroup>
		<ProjectReference Include="..\CloudLogin.Client\CloudLogin.Client.csproj" />
		<ProjectReference Include="..\CloudLogin.Components\CloudLogin.Components.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Remove="artifacts\**" />
		<None Update="amc-logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md" Pack="True" PackagePath="\" Link="README.md" />
	</ItemGroup>

	<!--
		The Blazor WebAssembly SDK marks the wasm boot runtime it generates during Build
		(dotnet.js, dotnet.native.*, dotnet.runtime.*, and the app/library .wasm assemblies
		under wwwroot/_framework) with AssetKind=Build instead of AssetKind=All, and
		CopyToPublishDirectory=Never. The RCL pack pipeline (GenerateStaticWebAssetsPackFiles)
		only packs assets whose AssetKind allows reuse by referencing packages, so these files
		are silently dropped from the .nupkg even though they exist in
		bin/$(Configuration)/$(TargetFramework)/wwwroot/_framework and are required at runtime
		by any host using AddInteractiveWebAssemblyRenderMode. They only come along automatically
		when this project is consumed via ProjectReference, because in that case the referencing
		project recomputes them at build time instead of reading this project's packed manifest.

		Promoting AssetKind to All makes them packable. CopyToPublishDirectory=Never must also be
		overridden to PreserveNewest: without it, consuming apps can still resolve these files
		locally via `dotnet run` (the endpoint manifest points straight at the file in the NuGet
		package cache on the dev machine), but `dotnet publish` excludes them from the publish
		output entirely. On a real deployment target (e.g. Azure App Service) there is no local
		NuGet cache to fall back to, so the files are simply missing and get served with an empty
		MIME type instead of the expected JS/Wasm content type.
	-->
	<Target Name="IncludeWasmRuntimeAssetsInPackage" BeforeTargets="GenerateStaticWebAssetsPackFiles">
		<ItemGroup>
			<StaticWebAsset Update="@(StaticWebAsset)" Condition="$([System.String]::Copy('%(StaticWebAsset.RelativePath)').StartsWith('_framework/')) And '%(StaticWebAsset.AssetKind)' == 'Build'">
				<AssetKind>All</AssetKind>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</StaticWebAsset>
		</ItemGroup>
	</Target>

</Project>
