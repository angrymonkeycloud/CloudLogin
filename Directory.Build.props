<Project>

  <PropertyGroup>
    <!--
      CloudLogin does not use Newtonsoft.Json.

      The Azure Cosmos SDK ships a build target that fails the build unless
      Newtonsoft.Json is explicitly referenced, because the SDK's own default
      serializer and its LINQ provider are built on it. Neither is reachable
      here:

        * the CosmosClient is constructed with a custom CosmosSerializer
          (ConfigurableCosmosSerializer) backed by System.Text.Json, so the
          default serializer is never used;
        * every query goes through QueryDefinition and GetItemQueryIterator,
          never GetItemLinqQueryable, so the LINQ provider is never invoked.

      Reintroducing Cosmos LINQ anywhere in this repository would make the
      SDK reach for Newtonsoft at runtime and fail with a missing-assembly
      error rather than at build time. Use raw SQL instead, or take the
      package reference back.

      The property applies solution-wide because the SDK's check runs in every
      project that references Cosmos transitively, not just the one that
      declares the package.
    -->
    <AzureCosmosDisableNewtonsoftJsonCheck>true</AzureCosmosDisableNewtonsoftJsonCheck>
  </PropertyGroup>

  <!--
    Shared NuGet package metadata for every project in this repository. Individual projects still
    set their own PackageId (via AssemblyName), Description and PackageTags - those are what
    actually distinguish one package from another - but the repository-wide facts (license,
    source, project link) belong in exactly one place so they can never drift out of sync between
    the eleven packages this repository publishes.

    Harmless on projects that are never packed (Tests, demo/*, the internal Packing tool): these
    properties are only ever read when a NuGet package is actually produced.
  -->
  <PropertyGroup>
    <PackageProjectUrl>https://github.com/angrymonkeycloud/CloudLogin</PackageProjectUrl>
    <RepositoryUrl>https://github.com/angrymonkeycloud/CloudLogin.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
