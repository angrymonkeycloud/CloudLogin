@page "/organizations"
@rendermode InteractiveServer
@inject DemoAccountRegistryWorkspace Workspace

<PageTitle>CloudLogin organizations and teams</PageTitle>

<DemoPageHeader Eyebrow="IOrganizationRegistry" Title="Organizations, teams, roles, permissions, and invitations." Description="Every interaction uses the real CloudLogin account-registry contracts. The generated identities are demo data; the organization and membership behavior is package behavior.">
    <a class="demo-button demo-button--secondary" href="/subscriptions">Continue to subscriptions</a>
</DemoPageHeader>

<DemoExample Title="Business identity and membership" Kind="Live public service workflow" Description="Create an organization, switch business context, add a member with application-defined roles and permissions, or issue an expiring invitation." Code="@DemoCodeSamples.Organizations" FileName="Organizations.razor">
    <div class="demo-org-workspace">
        <aside>
            <header><span>Organizations</span><b>@Workspace.Organizations.Count</b></header>
            @foreach (CloudLoginOrganization organizationSummary in Workspace.Organizations)
            {
                <button type="button" class="@(organizationSummary.Id == Workspace.SelectedOrganizationId ? "active" : null)" @onclick="() => SelectAsync(organizationSummary.Id)">
                    <span>@Initials(organizationSummary.Name)</span><div><strong>@organizationSummary.Name</strong><small>@ShortId(organizationSummary.Id)</small></div>
                </button>
            }
            <div class="demo-form-block"><label><span>New organization</span><input @bind="_organizationName" placeholder="Organization name" /></label><button class="demo-button demo-button--primary" disabled="@string.IsNullOrWhiteSpace(_organizationName)" @onclick="CreateAsync">Create</button></div>
        </aside>

        <section>
            @if (Workspace.SelectedOrganization is CloudLoginOrganization organization)
            {
                <header class="demo-org-header"><span>@Initials(organization.Name)</span><div><small>Selected business</small><h2>@organization.Name</h2><code>@organization.Id</code></div><dl><div><dt>Owner</dt><dd>@ShortId(organization.OwnerUserId)</dd></div><div><dt>Created</dt><dd>@organization.CreatedOn.ToLocalTime().ToString("dd MMM yyyy")</dd></div></dl></header>
                <div class="demo-section-tabs"><a class="active" href="#members">Members</a><a href="#invitations">Invitations</a><a href="/subscriptions">Subscriptions</a><a href="/billing">Billing</a></div>

                <div id="members" class="demo-registry-panel">
                    <header><div><span>Team directory</span><h3>@Workspace.Members.Count members</h3></div><small>Roles and permissions stay application-defined</small></header>
                    <div class="demo-member-list">
                        @foreach (CloudLoginOrganizationMember member in Workspace.Members)
                        {
                            <article><span>@(member.IsOwner ? "OW" : "MB")</span><div><strong>@(member.IsOwner ? "Organization owner" : $"Member {ShortId(member.UserId)}")</strong><small>@member.UserId</small></div><div class="demo-tags">@foreach (string role in member.Roles) { <b>@role</b> } @foreach (string permission in member.Permissions) { <b class="permission">@permission</b> }</div><em>@member.State</em></article>
                        }
                    </div>
                    <div class="demo-inline-form"><label><span>Roles</span><input @bind="_memberRoles" /></label><label><span>Permissions</span><input @bind="_memberPermissions" /></label><button class="demo-button demo-button--primary" @onclick="AddMemberAsync">Add generated member</button></div>
                </div>

                <div id="invitations" class="demo-registry-panel">
                    <header><div><span>Pending access</span><h3>Invitations</h3></div><small>Recipient, inviter, roles, creation, and expiry</small></header>
                    <div class="demo-invitation-list">
                        @foreach (CloudLoginOrganizationInvitation invitation in Workspace.Invitations.Where(item => item.OrganizationId == organization.Id))
                        {
                        <article><div><strong>@invitation.Recipient</strong><small>By @ShortId(invitation.InvitedByUserId)</small></div><div class="demo-tags">@foreach (string role in invitation.Roles) {
                            <b>@role</b>
                        }
                    </div><time>@invitation.ExpiresOn.ToLocalTime().ToString("dd MMM, HH:mm")</time></article>
                        }
                    </div>
                    <div class="demo-inline-form"><label><span>Recipient</span><input type="email" @bind="_inviteEmail" /></label><label><span>Roles</span><input @bind="_inviteRoles" /></label><button class="demo-button demo-button--primary" disabled="@string.IsNullOrWhiteSpace(_inviteEmail)" @onclick="InviteAsync">Create invitation</button></div>
                </div>
            }
        </section>
    </div>
    <p class="demo-status" role="status">@_message</p>
</DemoExample>

<DemoCallout Title="CloudLogin owns account structure—not application authorization policy" Icon="i">The registry stores role and permission codes. Your application decides what billing.manage, orders.read, or any other permission means.</DemoCallout>

@code {
    private string _organizationName = string.Empty;
    private string _memberRoles = "Developer, BillingAdmin";
    private string _memberPermissions = "orders.read, billing.manage";
    private string _inviteEmail = "developer@example.invalid";
    private string _inviteRoles = "Developer";
    private string _message = "A realistic organization workspace has been seeded for this browser session.";

    protected override async Task OnInitializedAsync() => await Workspace.InitializeAsync();

    private async Task SelectAsync(Guid organizationId)
    {
        await Workspace.SelectOrganizationAsync(organizationId);
        _message = $"Switched to {Workspace.SelectedOrganization?.Name}.";
    }

    private async Task CreateAsync()
    {
        CloudLoginOrganization organization = await Workspace.CreateOrganizationAsync(_organizationName);
        _organizationName = string.Empty;
        _message = $"Created {organization.Name} with an automatic owner membership.";
    }

    private async Task AddMemberAsync()
    {
        CloudLoginOrganizationMember member = await Workspace.AddMemberAsync(Guid.NewGuid(), Split(_memberRoles), Split(_memberPermissions));
        _message = $"Added member {ShortId(member.UserId)} with roles and permissions.";
    }

    private async Task InviteAsync()
    {
        CloudLoginOrganizationInvitation invitation = await Workspace.InviteAsync(_inviteEmail, Split(_inviteRoles));
        _inviteEmail = string.Empty;
        _message = $"Created invitation {ShortId(invitation.Id)} with a seven-day expiry.";
    }

    private static string[] Split(string value) => value.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    private static string ShortId(Guid value) => value.ToString("N")[..8];
    private static string Initials(string value) => string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
}
