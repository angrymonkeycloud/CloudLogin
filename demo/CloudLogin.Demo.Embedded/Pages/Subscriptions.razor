@page "/subscriptions"
@rendermode InteractiveServer
@using System.Text.Json
@inject DemoAccountRegistryState DemoState

<PageTitle>CloudLogin subscription registry</PageTitle>

<DemoPageHeader Eyebrow="ICloudLoginSubscriptionRegistry" Title="Application-owned subscriptions, visible at account level." Description="Save user or workspace subscriptions, inspect their complete registry history, and query whether an unexpired active reference exists. CloudLogin never assigns universal plan meaning.">
    <a class="demo-button demo-button--secondary" href="/billing">Continue to billing</a>
</DemoPageHeader>

<DemoExample Title="Subscription registry and active-state query" Kind="Live public service workflow" Description="Change ownership scope, status, expiry, renewal, provider reference, and application metadata, then execute the real registry methods." Code="@DemoCodeSamples.Subscriptions" FileName="Subscriptions.razor">
    <div class="demo-subscription-workspace">
        <aside>
            <header><span>New registry entry</span><h2>Subscription details</h2><p>Account state only—no payment is executed.</p></header>
            <div class="demo-scope"><button class="@(!_workspaceScope ? "active" : null)" @onclick="() => SetScopeAsync(false)">User</button><button class="@(_workspaceScope ? "active" : null)" @onclick="() => SetScopeAsync(true)">Workspace</button></div>
            <div class="demo-form-stack">
                <label><span>Application</span><input @bind="_application" /></label><label><span>Reference / SKU</span><input @bind="_reference" /></label>
                <div><label><span>Status</span><select @bind="_status">@foreach (CloudSubscriptionStatuses status in Enum.GetValues<CloudSubscriptionStatuses>()) { <option value="@status">@status</option> }</select></label><label><span>Expires in days</span><input type="number" min="0" @bind="_expiryDays" /></label></div>
                <label class="check"><input type="checkbox" @bind="_autoRenew" /><span>Auto-renew enabled</span></label>
                <div><label><span>Provider</span><input @bind="_provider" /></label><label><span>Provider reference</span><input @bind="_providerReference" /></label></div>
                <div><label><span>Credits metadata</span><input type="number" min="0" @bind="_credits" /></label><label class="check"><input type="checkbox" @bind="_premiumModels" /><span>Premium models</span></label></div>
                <button class="demo-button demo-button--primary" @onclick="SaveAsync">Save subscription</button><button class="demo-button demo-button--secondary" @onclick="CheckAsync">Run active check</button>
            </div>
            <p class="demo-status" data-success="@_activeCheck" role="status">@_message</p>
        </aside>
        <section>
            <header><div><span>@ScopeLabel</span><h2>Registry history</h2><p>Active and inactive records remain available to the application.</p></div><strong>@_history.Count records</strong></header>
            <div class="demo-subscription-list">
                @foreach (CloudSubscription subscription in _history.OrderByDescending(item => item.ExpiresOn))
                {
                    <article><header><div><span>@subscription.Application</span><h3>@subscription.Reference</h3></div><b data-status="@subscription.Status.ToString().ToLowerInvariant()">@subscription.Status</b></header><dl><div><dt>Owner</dt><dd>@(subscription.WorkspaceId is null ? "User" : DemoState.SelectedWorkspace?.Name)</dd></div><div><dt>Expires</dt><dd>@(subscription.ExpiresOn?.ToLocalTime().ToString("dd MMM yyyy") ?? "Never")</dd></div><div><dt>Auto-renew</dt><dd>@(subscription.AutoRenew ? "Enabled" : "Disabled")</dd></div><div><dt>Provider</dt><dd>@(subscription.Provider ?? "Application")</dd></div><div><dt>Provider reference</dt><dd><code>@(subscription.ProviderReference ?? "—")</code></dd></div></dl><div class="demo-tags">@foreach (KeyValuePair<string, JsonElement> metadata in subscription.Metadata) { <b class="permission">@metadata.Key: @metadata.Value</b> }</div></article>
                }
            </div>
        </section>
    </div>
</DemoExample>

<DemoCallout Tone="warning" Icon="!" Title="Not a universal subscription engine">Your application owns entitlements, usage, credits, seats, renewal policy, and cancellation semantics. CloudLogin stores and exposes the account-level record.</DemoCallout>

@code {
    private bool _workspaceScope = true;
    private string _application = "cloud-business";
    private string _reference = "team-enterprise";
    private CloudSubscriptionStatuses _status = CloudSubscriptionStatuses.Active;
    private int _expiryDays = 30;
    private bool _autoRenew = true;
    private string _provider = "Stripe";
    private string _providerReference = "sub_sandbox_reference";
    private int _credits = 25_000;
    private bool _premiumModels = true;
    private IReadOnlyList<CloudSubscription> _history = [];
    private string _message = "Inspect the seeded workspace subscription or create another.";
    private bool _activeCheck;

    private string ScopeLabel => _workspaceScope ? $"Workspace · {DemoState.SelectedWorkspace?.Name}" : "Owner user";

    protected override async Task OnInitializedAsync() { await DemoState.InitializeAsync(); await RefreshAsync(); }

    private async Task SetScopeAsync(bool workspaceScope) { _workspaceScope = workspaceScope; _activeCheck = false; _message = $"Showing {ScopeLabel}."; await RefreshAsync(); }

    private async Task SaveAsync()
    {
        await DemoState.SaveSubscriptionAsync(new CloudSubscription
        {
            UserId = _workspaceScope ? null : DemoState.OwnerUserId,
            WorkspaceId = _workspaceScope ? DemoState.SelectedWorkspaceId : null,
            Application = _application,
            Reference = _reference,
            Status = _status,
            ExpiresOn = _expiryDays == 0 ? null : DateTimeOffset.UtcNow.AddDays(_expiryDays),
            AutoRenew = _autoRenew,
            Provider = string.IsNullOrWhiteSpace(_provider) ? null : _provider,
            ProviderReference = string.IsNullOrWhiteSpace(_providerReference) ? null : _providerReference,
            Metadata = { ["credits"] = JsonSerializer.SerializeToElement(_credits), ["premiumModels"] = JsonSerializer.SerializeToElement(_premiumModels) }
        });
        _activeCheck = _status == CloudSubscriptionStatuses.Active;
        _message = $"Saved {_status} subscription '{_reference}' for {ScopeLabel}.";
        await RefreshAsync();
    }

    private async Task CheckAsync()
    {
        _activeCheck = await DemoState.HasActiveSubscriptionAsync(_application, _reference, _workspaceScope);
        _message = _activeCheck ? $"Active '{_reference}' subscription found for {ScopeLabel}." : $"No active, unexpired '{_reference}' subscription found for {ScopeLabel}.";
    }

    private async Task RefreshAsync() => _history = await DemoState.GetSubscriptionsAsync(_workspaceScope);
}
