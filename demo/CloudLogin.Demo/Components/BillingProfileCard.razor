<article class="authority-billing-card">
    <header><div><span>@Scope</span><h2>@Title</h2></div><b>@(Profile?.PaymentMethods.Count ?? 0) methods</b></header>
    @if (Profile is null)
    {
        <p>No billing profile has been saved.</p>
    }
    else
    {
        <small>Provider customer reference</small><code>@Profile.ProviderCustomerReference</code>
        <div class="authority-payment-methods">
            @foreach (CloudPaymentMethodReference method in Profile.PaymentMethods)
            {
                <div><span>@method.Provider[..Math.Min(2, method.Provider.Length)].ToUpperInvariant()</span><div><strong>@method.DisplayName</strong><small>@method.Reference</small></div>@if (method.IsDefault) { <b>Default</b> }</div>
            }
        </div>
    }
</article>

@code {
    [Parameter, EditorRequired] public required string Title { get; set; }
    [Parameter, EditorRequired] public required string Scope { get; set; }
    [Parameter] public CloudBillingProfile? Profile { get; set; }
}
