@page "/demo"
@inject DemoAccountRegistrySeed Seed
@inject ICloudLoginAccountStore Accounts

<PageTitle>CloudLogin authority developer showcase</PageTitle>

<section class="authority-hero">
    <div>
        <p class="authority-eyebrow">Standalone authority · seeded and runnable</p>
        <h1>See every CloudLogin account capability in one place.</h1>
        <p>The normal authentication and account pages remain real CloudLogin UI. These showcase pages expose the organization, subscription, and billing registries using realistic data seeded through their public contracts.</p>
        <div class="authority-actions"><a class="primary" href="/">Try authentication</a><a href="/demo/subscriptions">View subscriptions</a></div>
    </div>
    <aside>
        <span>Seed snapshot</span>
        <strong>@Seed.Organizations.Count organizations</strong>
        <strong>@_subscriptionCount subscriptions</strong>
        <strong>@Seed.Invitations.Count pending invitations</strong>
        <small>Recreated on application restart</small>
    </aside>
</section>

<section class="authority-section">
    <header><p>Feature map</p><h2>Package UI and account infrastructure</h2></header>
    <div class="authority-feature-grid">
        <a href="/"><span>SHIPPED UI</span><h3>Authentication</h3><p>Password, email code, recovery, registration, and instant Test Mode.</p></a>
        <a href="/Account"><span>SHIPPED UI</span><h3>Account center</h3><p>Profile, contact methods, lifecycle operations, and global administration.</p></a>
        <a href="/demo/organizations"><span>PUBLIC SERVICE</span><h3>Organizations</h3><p>Businesses, owners, teams, roles, permissions, and invitations.</p></a>
        <a href="/demo/subscriptions"><span>PUBLIC SERVICE</span><h3>Subscriptions</h3><p>User and organization scopes, expiry, renewal, providers, and metadata.</p></a>
        <a href="/demo/billing"><span>PUBLIC CONTRACT</span><h3>Billing references</h3><p>Provider customers and saved payment-method tokens without transaction logic.</p></a>
        <a href="/demo/inbox.html"><span>DEMO TOOL</span><h3>Verification inbox</h3><p>Codes captured from the real email-code callback without requiring SMTP.</p></a>
    </div>
</section>

<details class="authority-code"><summary>Registration code</summary><pre><code>@DemoCodeSamples.Registration</code></pre></details>

@code {
    private int _subscriptionCount;

    protected override async Task OnInitializedAsync()
    {
        await Seed.InitializeAsync();
        IReadOnlyList<AccountSubscription> userSubscriptions = await Accounts.GetSubscriptionsAsync(Seed.OwnerUserId, null);
        _subscriptionCount = userSubscriptions.Count;
        foreach (CloudLoginOrganization organization in Seed.Organizations)
            _subscriptionCount += (await Accounts.GetSubscriptionsAsync(null, organization.Id)).Count;
    }
}
