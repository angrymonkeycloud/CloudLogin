@page "/demo/subscriptions"
@inject DemoAccountRegistrySeed Seed
@inject ICloudLoginAccountStore Accounts

<PageTitle>CloudLogin subscriptions demo</PageTitle>

<header class="authority-page-header"><p>ICloudLoginSubscriptionRegistry</p><h1>User and business subscriptions</h1><span>CloudLogin answers account-level subscription questions while each application owns entitlements, usage, renewal policy, and plan meaning.</span></header>

<section class="authority-subscription-scope">
    <header><div><span>USER ACCOUNT</span><h2>Demo account owner</h2><code>@Seed.OwnerUserId</code></div><b>@_userSubscriptions.Count records</b></header>
    <div class="authority-subscriptions">
        @foreach (CloudSubscription subscription in _userSubscriptions)
        {
            <SubscriptionCard Value="subscription" />
        }
    </div>
</section>

@foreach (CloudWorkspace workspace in Seed.Workspaces)
{
    IReadOnlyList<CloudSubscription> subscriptions = _workspaceSubscriptions.GetValueOrDefault(workspace.Id, []);
    <section class="authority-subscription-scope">
        <header><div><span>WORKSPACE</span><h2>@workspace.Name</h2><code>@workspace.Id</code></div><b>@subscriptions.Count records</b></header>
        <div class="authority-subscriptions">
            @foreach (CloudSubscription subscription in subscriptions)
            {
                <SubscriptionCard Value="subscription" />
            }
        </div>
    </section>
}

<details class="authority-code"><summary>Subscription integration code</summary><pre><code>@DemoCodeSamples.Subscriptions</code></pre></details>

@code {
    private IReadOnlyList<CloudSubscription> _userSubscriptions = [];
    private readonly Dictionary<Guid, IReadOnlyList<CloudSubscription>> _workspaceSubscriptions = [];

    protected override async Task OnInitializedAsync()
    {
        await Seed.InitializeAsync();
        _userSubscriptions = await Accounts.GetSubscriptionsAsync(Seed.OwnerUserId, null);
        foreach (CloudWorkspace workspace in Seed.Workspaces)
            _workspaceSubscriptions[workspace.Id] = await Accounts.GetSubscriptionsAsync(null, workspace.Id);
    }
}
