@page "/demo/subscriptions"
@inject DemoAccountRegistrySeed Seed
@inject ICloudLoginAccountStore Accounts

<PageTitle>CloudLogin subscriptions demo</PageTitle>

<header class="authority-page-header"><p>ISubscriptionRegistry</p><h1>User and business subscriptions</h1><span>CloudLogin answers account-level subscription questions while each application owns entitlements, usage, renewal policy, and plan meaning.</span></header>

<section class="authority-subscription-scope">
    <header><div><span>USER ACCOUNT</span><h2>Demo account owner</h2><code>@Seed.OwnerUserId</code></div><b>@_userSubscriptions.Count records</b></header>
    <div class="authority-subscriptions">
        @foreach (AccountSubscription subscription in _userSubscriptions)
        {
            <SubscriptionCard Value="subscription" />
        }
    </div>
</section>

@foreach (CloudLoginOrganization organization in Seed.Organizations)
{
    IReadOnlyList<AccountSubscription> subscriptions = _organizationSubscriptions.GetValueOrDefault(organization.Id, []);
    <section class="authority-subscription-scope">
        <header><div><span>ORGANIZATION</span><h2>@organization.Name</h2><code>@organization.Id</code></div><b>@subscriptions.Count records</b></header>
        <div class="authority-subscriptions">
            @foreach (AccountSubscription subscription in subscriptions)
            {
                <SubscriptionCard Value="subscription" />
            }
        </div>
    </section>
}

<details class="authority-code"><summary>Subscription integration code</summary><pre><code>@DemoCodeSamples.Subscriptions</code></pre></details>

@code {
    private IReadOnlyList<AccountSubscription> _userSubscriptions = [];
    private readonly Dictionary<Guid, IReadOnlyList<AccountSubscription>> _organizationSubscriptions = [];

    protected override async Task OnInitializedAsync()
    {
        await Seed.InitializeAsync();
        _userSubscriptions = await Accounts.GetSubscriptionsAsync(Seed.OwnerUserId, null);
        foreach (CloudLoginOrganization organization in Seed.Organizations)
            _organizationSubscriptions[organization.Id] = await Accounts.GetSubscriptionsAsync(null, organization.Id);
    }
}
