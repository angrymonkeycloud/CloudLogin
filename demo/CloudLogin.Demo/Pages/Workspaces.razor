@page "/demo/workspaces"
@inject DemoAccountRegistrySeed Seed
@inject ICloudLoginWorkspaceRegistry WorkspaceRegistry

<PageTitle>CloudLogin workspaces demo</PageTitle>

<header class="authority-page-header"><p>ICloudLoginWorkspaceRegistry</p><h1>Workspaces, teams, and invitations</h1><span>The cards below are seeded through the same public registry developers inject into their applications.</span></header>

<div class="authority-workspace-grid">
    @foreach (CloudWorkspace workspace in Seed.Workspaces)
    {
        IReadOnlyList<CloudWorkspaceMember> members = _members.GetValueOrDefault(workspace.Id, []);
        <article>
            <header><span>@Initials(workspace.Name)</span><div><small>Business account</small><h2>@workspace.Name</h2><code>@workspace.Id</code></div></header>
            <dl><div><dt>Owner</dt><dd>@ShortId(workspace.OwnerUserId)</dd></div><div><dt>Members</dt><dd>@members.Count</dd></div><div><dt>Created</dt><dd>@workspace.CreatedOn.ToString("dd MMM yyyy")</dd></div></dl>
            <h3>Team directory</h3>
            <ul class="authority-people">
                @foreach (CloudWorkspaceMember member in members)
                {
                    <li><span>@(member.IsOwner ? "OW" : "MB")</span><div><strong>@(member.IsOwner ? "Workspace owner" : $"Member {ShortId(member.UserId)}")</strong><small>@string.Join(" · ", member.Roles)</small></div><div class="authority-tags">@foreach (string permission in member.Permissions) { <b>@permission</b> }</div></li>
                }
            </ul>
            <h3>Pending invitations</h3>
            @foreach (CloudWorkspaceInvitation invitation in Seed.Invitations.Where(item => item.WorkspaceId == workspace.Id))
            {
            <div class="authority-invitation"><div><strong>@invitation.Recipient</strong><small>@string.Join(", ", invitation.Roles)</small></div><time>Expires @invitation.ExpiresOn.ToString("dd MMM, HH:mm")</time></div>
            }
        </article>
    }
</div>

<details class="authority-code"><summary>Workspace integration code</summary><pre><code>@DemoCodeSamples.Workspaces</code></pre></details>

@code {
    private readonly Dictionary<Guid, IReadOnlyList<CloudWorkspaceMember>> _members = [];

    protected override async Task OnInitializedAsync()
    {
        await Seed.InitializeAsync();
        foreach (CloudWorkspace workspace in Seed.Workspaces)
            _members[workspace.Id] = await WorkspaceRegistry.GetMembersAsync(workspace.Id);
    }

    private static string Initials(string value) => string.Concat(value.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => char.ToUpperInvariant(part[0])));
    private static string ShortId(Guid id) => id.ToString("N")[..8];
}
